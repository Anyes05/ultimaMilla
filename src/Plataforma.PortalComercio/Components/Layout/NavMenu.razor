<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/#nuevo-envio">
            <span class="brand-mark" style="--operator-color: @ColorMarcaCss" aria-hidden="true"></span>
            <span>
                <span class="d-block">Portal Comercio</span>
                @if (!string.IsNullOrWhiteSpace(NombreOperador))
                {
                    <small class="operator-brand">@NombreOperador</small>
                }
                @if (!string.IsNullOrWhiteSpace(ContactoOperador))
                {
                    <small class="operator-brand d-block" data-contacto-operador>@ContactoOperador</small>
                }
            </span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            @* Mismo documento que "Mis envíos": con el ancla, vuelve al formulario aunque la lista esté abajo. *@
            <NavLink class="nav-link" href="/#nuevo-envio" Match="NavLinkMatch.All">Nuevo envío</NavLink>
        </div>
        <div class="nav-item px-3">
            <a class="nav-link" href="/#mis-envios">Mis envíos</a>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="importar">Importar envíos</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="devoluciones">Devoluciones</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="cuenta">Cuenta corriente</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="retiros">Retiros</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="avisos">Avisos automáticos</NavLink>
        </div>
    </nav>

    @* Igual que el Backoffice: quién está conectado y con qué perfil, al pie del menú. *@
    @if (!string.IsNullOrWhiteSpace(NombreUsuario))
    {
        <div class="sesion">
            <span class="sesion__titulo">Sesión</span>
            <span class="sesion__usuario">@NombreUsuario</span>
            <span class="sesion__perfil">Comercio</span>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? NombreOperador { get; set; }

    [Parameter]
    public string ColorMarcaCss { get; set; } = "#4f46e5";

    [Parameter]
    public string? NombreUsuario { get; set; }

    [Parameter]
    public string? ContactoOperador { get; set; }
}
