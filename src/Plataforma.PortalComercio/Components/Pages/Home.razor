@page "/"
@using Plataforma.Application
@using Plataforma.Domain
@inject IEnvioRepositorio Repositorio

<h3>Alta de Envío (Portal Comercio)</h3>

<EditForm method="post" Model="Formulario" OnValidSubmit="GuardarEnvio" FormName="AltaEnvioForm">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger mb-3" />

    <div class="mb-3">
        <label class="form-label">Destinatario:</label>
        <InputText @bind-Value="Formulario!.Destinatario" class="form-control" />
        <ValidationMessage For="() => Formulario!.Destinatario" />
    </div>
    <div class="mb-3">
        <label class="form-label">Dirección de Entrega:</label>
        <InputText @bind-Value="Formulario!.Direccion" class="form-control" />
        <ValidationMessage For="() => Formulario!.Direccion" />
    </div>
    <button type="submit" class="btn btn-primary">Crear Envío</button>
</EditForm>

@if (mensaje != null)
{
    <div class="alert alert-success mt-3">@mensaje</div>
}

@code {
    [SupplyParameterFromForm(FormName = "AltaEnvioForm")]
    private ModelForm? Formulario { get; set; }

    private string? mensaje;

    protected override void OnInitialized()
    {
        Formulario ??= new();
    }

    private async Task GuardarEnvio()
    {
        Formulario ??= new();

        var operadorId = Guid.Parse("11111111-1111-1111-1111-111111111111");
        var comercioId = Guid.Parse("22222222-2222-2222-2222-222222222222");

        var envio = Envio.Admitir(
            operadorId,
            comercioId,
            Formulario.Destinatario,
            Formulario.Direccion);

        await Repositorio.AgregarAsync(envio);
        mensaje = $"Envío creado con éxito. Tracking: {envio.NumeroSeguimiento}";
        Formulario = new();
    }

    public class ModelForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El destinatario es requerido.")]
        public string Destinatario { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La dirección es requerida.")]
        public string Direccion { get; set; } = string.Empty;
    }
}
