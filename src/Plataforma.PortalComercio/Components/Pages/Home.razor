@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = Plataforma.Domain.Roles.Comercio)]
@using Plataforma.Application
@using Plataforma.Domain
@inject IHttpContextAccessor HttpContextAccessor
@inject IEnvioRepositorio Repositorio
@inject ListarEnvios ListarEnvios
@inject NavigationManager Navegacion

<PageTitle>Nuevo envío</PageTitle>

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
        <p class="text-uppercase text-primary fw-semibold small mb-1">Portal de comercio</p>
        <h1 class="display-6 fw-bold mb-1">Crear un envío</h1>
        <p class="text-muted mb-0">Registrá una entrega y obtené su número de seguimiento al instante.</p>
    </div>
    <form method="post" action="/logout">
        <button class="btn btn-outline-secondary" type="submit">Cerrar sesión</button>
    </form>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-4">Datos de la entrega</h2>
                @if (mensajeError is not null)
                {
                    <div class="alert alert-danger" role="alert">@mensajeError</div>
                }
                <EditForm method="post" Model="Formulario" OnValidSubmit="GuardarEnvio" FormName="AltaEnvioForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger py-2" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="destinatario">Destinatario</label>
                        <InputText id="destinatario" @bind-Value="Formulario!.Destinatario" class="form-control form-control-lg" placeholder="Nombre y apellido" />
                        <ValidationMessage For="() => Formulario!.Destinatario" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="direccion">Dirección de entrega</label>
                        <InputText id="direccion" @bind-Value="Formulario!.Direccion" class="form-control form-control-lg" placeholder="Calle, número y localidad" />
                        <ValidationMessage For="() => Formulario!.Direccion" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100">Crear envío</button>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 bg-primary-subtle h-100">
            <div class="card-body p-4">
                <h2 class="h5">Cómo funciona</h2>
                <ol class="text-muted ps-3 mb-0">
                    <li class="mb-2">Completá los datos del destinatario.</li>
                    <li class="mb-2">Guardá el envío.</li>
                    <li>Compartí el número de seguimiento con tu cliente.</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section id="mis-envios" class="mt-5" aria-labelledby="mis-envios-titulo">
    <div class="d-flex justify-content-between align-items-end gap-3 mb-3">
        <div>
            <p class="text-uppercase text-primary fw-semibold small mb-1">Seguimiento</p>
            <h2 id="mis-envios-titulo" class="h3 fw-bold mb-1">Mis envíos</h2>
            <p class="text-muted mb-0">Envíos registrados por tu comercio.</p>
        </div>
        <span class="badge rounded-pill text-bg-light">@Envios.Count</span>
    </div>

    @if (Envios.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <h3 class="h5">Todavía no hay envíos</h3>
                <p class="text-muted mb-0">Cuando crees un envío, aparecerá aquí con su número de seguimiento.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var envio in Envios)
            {
                <div class="col-12 col-xl-6" @key="envio.Id">
                    <article class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                <div>
                                    <span class="small text-muted d-block">Número de seguimiento</span>
                                    <strong class="tracking-number">@envio.NumeroSeguimiento</strong>
                                </div>
                                <span class="status-badge @EstadoClase(envio.Estado)">@EstadoNombre(envio.Estado)</span>
                            </div>
                            <h3 class="h6 mb-1">@envio.Destinatario</h3>
                            <p class="text-muted mb-0">@envio.DireccionEntrega</p>
                            <p class="small text-muted mt-3 mb-0">Creado @envio.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>

@if (MostrarConfirmacion)
{
    <div class="alert alert-success shadow-sm mt-4">
        <strong>Envío creado.</strong>
        <span class="d-block">Envío creado con éxito. Tracking: @TrackingCreado</span>
    </div>
}

@code {
    [SupplyParameterFromForm(FormName = "AltaEnvioForm")]
    private ModelForm? Formulario { get; set; }

    [SupplyParameterFromQuery(Name = "tracking")]
    private string? TrackingCreado { get; set; }

    private List<Envio> Envios { get; set; } = [];
    private string? mensajeError;
    private bool MostrarConfirmacion =>
        !string.IsNullOrWhiteSpace(TrackingCreado)
        && Envios.Any(envio => envio.NumeroSeguimiento == TrackingCreado);

    protected override void OnInitialized()
    {
        Formulario ??= new();
    }

    protected override async Task OnInitializedAsync()
    {
        await ActualizarEnviosAsync();
    }

    private async Task GuardarEnvio()
    {
        Formulario ??= new();

        if (!IntentarObtenerAcceso(out var acceso) || acceso.ComercioId is not Guid comercioId)
        {
            mensajeError = "No se pudo identificar el comercio autenticado. Volvé a iniciar sesión.";
            return;
        }

        var envio = Envio.Admitir(
            acceso.OperadorId,
            comercioId,
            Formulario.Destinatario,
            Formulario.Direccion);

        await Repositorio.AgregarAsync(envio);
        mensajeError = null;
        Navegacion.NavigateTo(
            $"/?tracking={Uri.EscapeDataString(envio.NumeroSeguimiento)}#mis-envios",
            forceLoad: true);
    }

    private async Task ActualizarEnviosAsync()
    {
        if (!IntentarObtenerAcceso(out var acceso))
        {
            mensajeError = "No se pudo cargar el comercio autenticado. Volvé a iniciar sesión.";
            return;
        }

        Envios = await ListarEnvios.Ejecutar(acceso);
    }

    private bool IntentarObtenerAcceso(out AccesoActual acceso)
    {
        var principal = HttpContextAccessor.HttpContext?.User ?? new System.Security.Claims.ClaimsPrincipal();
        return AccesoActual.Intentar(principal, out acceso)
            && acceso.Rol == Roles.Comercio
            && acceso.ComercioId.HasValue;
    }

    private static string EstadoClase(EstadoEnvio estado) => estado switch
    {
        EstadoEnvio.EnDeposito => "status-en-deposito",
        EstadoEnvio.AsignadoARuta => "status-asignado-a-ruta",
        EstadoEnvio.EnTransito => "status-en-transito",
        EstadoEnvio.NoEntregado => "status-no-entregado",
        EstadoEnvio.EnDevolucion => "status-en-devolucion",
        _ => "status-" + estado.ToString().ToLowerInvariant()
    };

    private static string EstadoNombre(EstadoEnvio estado) => estado switch
    {
        EstadoEnvio.EnDeposito => "En depósito",
        EstadoEnvio.AsignadoARuta => "Asignado a ruta",
        EstadoEnvio.EnTransito => "En tránsito",
        EstadoEnvio.NoEntregado => "No entregado",
        EstadoEnvio.EnDevolucion => "En devolución",
        _ => estado.ToString()
    };

    public class ModelForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El destinatario es requerido.")]
        public string Destinatario { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La dirección es requerida.")]
        public string Direccion { get; set; } = string.Empty;
    }
}
