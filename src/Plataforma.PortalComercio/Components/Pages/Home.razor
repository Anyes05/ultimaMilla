@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = Plataforma.Domain.Roles.Comercio)]
@using Plataforma.Application
@using Plataforma.Domain
@inject IHttpContextAccessor HttpContextAccessor
@inject AdmitirEnvio AdmitirEnvio
@inject GestionCobertura Cobertura
@inject ListarEnvios ListarEnvios
@inject NavigationManager Navegacion

<PageTitle>Nuevo envío</PageTitle>

<div id="nuevo-envio" class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
        <p class="text-uppercase text-primary fw-semibold small mb-1">Portal de comercio</p>
        <h1 class="display-6 fw-bold mb-1">Crear un envío</h1>
        <p class="text-muted mb-0">Registrá una entrega y obtené su número de seguimiento al instante.</p>
    </div>
    <form method="post" action="/logout">
        <button class="btn btn-outline-secondary" type="submit">Cerrar sesión</button>
    </form>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-4">Datos de la entrega</h2>
                @if (mensajeError is not null)
                {
                    <div class="alert alert-danger" role="alert">@mensajeError</div>
                }
                <EditForm method="post" Model="Formulario" OnValidSubmit="GuardarEnvio" FormName="AltaEnvioForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger py-2" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="destinatario">Destinatario</label>
                        <InputText id="destinatario" @bind-Value="Formulario!.Destinatario" class="form-control form-control-lg" placeholder="Nombre y apellido" />
                        <ValidationMessage For="() => Formulario!.Destinatario" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="direccion">Dirección de entrega</label>
                        <InputText id="direccion" @bind-Value="Formulario!.Direccion" class="form-control form-control-lg" placeholder="Calle, número y localidad" />
                        <ValidationMessage For="() => Formulario!.Direccion" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="email">Email del destinatario <span class="text-muted fw-normal">(opcional)</span></label>
                        <InputText id="email" type="email" @bind-Value="Formulario!.Email" class="form-control" placeholder="Para enviarle el enlace de seguimiento" />
                        <ValidationMessage For="() => Formulario!.Email" />
                    </div>

                    @if (Zonas.Count > 0 || Franjas.Count > 0)
                    {
                        <h3 class="h6 mb-3">Zona y horario de entrega</h3>
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold" for="zona">Zona <span class="text-muted fw-normal">(opcional)</span></label>
                                <InputSelect id="zona" @bind-Value="Formulario!.ZonaId" class="form-select">
                                    <option value="">Sin zona</option>
                                    @foreach (var zona in Zonas)
                                    {
                                        <option value="@zona.Id">@zona.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold" for="franja">Franja horaria <span class="text-muted fw-normal">(opcional)</span></label>
                                <InputSelect id="franja" @bind-Value="Formulario!.FranjaId" class="form-select">
                                    <option value="">Sin franja</option>
                                    @foreach (var franja in Franjas)
                                    {
                                        <option value="@franja.Id">@franja.Nombre (@franja.Desde.ToString("HH:mm") a @franja.Hasta.ToString("HH:mm"))</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    }

                    <h3 class="h6 mb-3">Datos para la tarifa</h3>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-4">
                            <label class="form-label fw-semibold" for="bultos">Bultos</label>
                            <InputNumber id="bultos" @bind-Value="Formulario!.CantidadBultos" class="form-control" min="1" max="20" />
                            <ValidationMessage For="() => Formulario!.CantidadBultos" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label fw-semibold" for="peso">Peso total (kg)</label>
                            <InputNumber id="peso" @bind-Value="Formulario!.PesoKg" class="form-control" step="any" min="0.001" max="1000" />
                            <ValidationMessage For="() => Formulario!.PesoKg" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label fw-semibold" for="distancia">Distancia (km)</label>
                            <InputNumber id="distancia" @bind-Value="Formulario!.DistanciaKm" class="form-control" step="0.1" min="0" />
                            <ValidationMessage For="() => Formulario!.DistanciaKm" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label fw-semibold" for="volumen">Volumen (cm³)</label>
                            <InputNumber id="volumen" @bind-Value="Formulario!.VolumenCm3" class="form-control" step="any" min="0" />
                            <ValidationMessage For="() => Formulario!.VolumenCm3" />
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-4 mb-4">
                        <div class="form-check">
                            <InputCheckbox id="urgente" @bind-Value="Formulario!.Urgente" class="form-check-input" />
                            <label class="form-check-label" for="urgente">Envío urgente</label>
                        </div>
                        <div class="form-check">
                            <InputCheckbox id="fragil" @bind-Value="Formulario!.Fragil" class="form-check-input" />
                            <label class="form-check-label" for="fragil">Contenido frágil</label>
                        </div>
                    </div>
                    <p class="small text-muted">El costo se calcula automáticamente al crear el envío, según las tarifas de tu operador.</p>
                    <button type="submit" class="btn btn-primary btn-lg w-100">Crear envío</button>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 bg-primary-subtle h-100">
            <div class="card-body p-4">
                <h2 class="h5">Cómo funciona</h2>
                <ol class="text-muted ps-3 mb-0">
                    <li class="mb-2">Completá los datos del destinatario.</li>
                    <li class="mb-2">Guardá el envío.</li>
                    <li>Compartí el número de seguimiento con tu cliente.</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section id="mis-envios" class="mt-5" aria-labelledby="mis-envios-titulo">
    <div class="d-flex justify-content-between align-items-end gap-3 mb-3">
        <div>
            <p class="text-uppercase text-primary fw-semibold small mb-1">Seguimiento</p>
            <h2 id="mis-envios-titulo" class="h3 fw-bold mb-1">Mis envíos</h2>
            <p class="text-muted mb-0">Envíos registrados por tu comercio.</p>
        </div>
        <span class="badge rounded-pill text-bg-light">@Envios.Count</span>
    </div>

    @if (Envios.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <h3 class="h5">Todavía no hay envíos</h3>
                <p class="text-muted mb-0">Cuando crees un envío, aparecerá aquí con su número de seguimiento.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var envio in Envios)
            {
                <div class="col-12 col-xl-6" @key="envio.Id">
                    <article class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                <div class="min-w-0">
                                    <span class="small text-muted d-block">Número de seguimiento</span>
                                    <strong class="tracking-number">@envio.NumeroSeguimiento</strong>
                                </div>
                                <span class="status-badge @EstadosVista.Clase(envio.Estado)">@EstadosVista.Nombre(envio.Estado)</span>
                            </div>
                            <h3 class="h6 mb-1">@envio.Destinatario</h3>
                            <p class="text-muted mb-0">@envio.DireccionEntrega</p>
                            <div class="d-flex justify-content-between small text-muted mt-3">
                                <span>Creado @envio.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                <span>Tarifa <strong class="text-body">@Importe(envio.TarifaCalculada)</strong></span>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>

@if (MostrarConfirmacion)
{
    <div class="alert alert-success shadow-sm mt-4">
        <strong>Envío creado.</strong>
        <span class="d-block">Envío creado con éxito. Tracking: @TrackingCreado</span>
        <span class="d-block">Tarifa calculada: @Importe(EnvioCreado!.TarifaCalculada)</span>
    </div>
}

@code {
    [SupplyParameterFromForm(FormName = "AltaEnvioForm")]
    private ModelForm? Formulario { get; set; }

    [SupplyParameterFromQuery(Name = "tracking")]
    private string? TrackingCreado { get; set; }

    private List<Envio> Envios { get; set; } = [];
    private IReadOnlyList<ZonaCobertura> Zonas { get; set; } = [];
    private IReadOnlyList<FranjaHoraria> Franjas { get; set; } = [];
    private string? mensajeError;
    private Envio? EnvioCreado =>
        string.IsNullOrWhiteSpace(TrackingCreado)
            ? null
            : Envios.FirstOrDefault(envio => envio.NumeroSeguimiento == TrackingCreado);
    private bool MostrarConfirmacion => EnvioCreado is not null;

    protected override void OnInitialized()
    {
        Formulario ??= new();
    }

    protected override async Task OnInitializedAsync()
    {
        await ActualizarEnviosAsync();
    }

    private async Task GuardarEnvio()
    {
        Formulario ??= new();

        if (!IntentarObtenerAcceso(out var acceso) || acceso.ComercioId is not Guid comercioId)
        {
            mensajeError = "No se pudo identificar el comercio autenticado. Volvé a iniciar sesión.";
            return;
        }

        Envio envio;
        try
        {
            // El caso de uso calcula la tarifa con la regla vigente del operador (RF 9) y persiste el envío.
            envio = await AdmitirEnvio.EjecutarAsync(
                acceso.OperadorId,
                comercioId,
                Formulario.Destinatario,
                Formulario.Direccion,
                Formulario.Email?.Trim() ?? string.Empty,
                Formulario.PesoKg,
                Formulario.DistanciaKm,
                Formulario.Fragil,
                Formulario.Urgente,
                Formulario.CantidadBultos,
                Formulario.ZonaId,
                Formulario.FranjaId,
                Formulario.VolumenCm3);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            mensajeError = TextosUsuario.Error(ex);
            await ActualizarEnviosAsync();
            return;
        }

        mensajeError = null;
        Navegacion.NavigateTo(
            $"/?tracking={Uri.EscapeDataString(envio.NumeroSeguimiento)}#mis-envios",
            forceLoad: true);
    }

    private async Task ActualizarEnviosAsync()
    {
        if (!IntentarObtenerAcceso(out var acceso))
        {
            mensajeError = "No se pudo cargar el comercio autenticado. Volvé a iniciar sesión.";
            return;
        }

        Envios = await ListarEnvios.Ejecutar(acceso);
        Zonas = await Cobertura.ListarZonasAsync(acceso.OperadorId);
        Franjas = await Cobertura.ListarFranjasAsync(acceso.OperadorId);
    }

    private bool IntentarObtenerAcceso(out AccesoActual acceso)
    {
        var principal = HttpContextAccessor.HttpContext?.User ?? new System.Security.Claims.ClaimsPrincipal();
        return AccesoActual.Intentar(principal, out acceso)
            && acceso.Rol == Roles.Comercio
            && acceso.ComercioId.HasValue;
    }

    private static string Importe(decimal valor) =>
        valor.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-UY"));

    public class ModelForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El destinatario es requerido.")]
        public string Destinatario { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La dirección es requerida.")]
        public string Direccion { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "El email no es válido.")]
        public string? Email
        {
            get => email;
            // Es opcional: vacío llega como "" y [EmailAddress] solo deja pasar null.
            set => email = string.IsNullOrWhiteSpace(value) ? null : value;
        }

        private string? email;

        [System.ComponentModel.DataAnnotations.Range(typeof(decimal), "0", "1000", MinimumIsExclusive = true, ErrorMessage = "El peso debe ser mayor que 0 y de hasta 1000 kg.")]
        public decimal PesoKg { get; set; }

        [System.ComponentModel.DataAnnotations.Range(typeof(decimal), "0", "500", ErrorMessage = "La distancia debe estar entre 0 y 500 km.")]
        public decimal DistanciaKm { get; set; }

        [System.ComponentModel.DataAnnotations.Range(typeof(decimal), "0", "10000000", ErrorMessage = "El volumen debe estar entre 0 y 10.000.000 cm³.")]
        public decimal VolumenCm3 { get; set; }

        public Guid? ZonaId { get; set; }

        public Guid? FranjaId { get; set; }

        public bool Urgente { get; set; }

        // Un envío puede tener varios bultos (RF 8); cada uno se entrega o devuelve por separado (RF 31).
        [System.ComponentModel.DataAnnotations.Range(1, 20, ErrorMessage = "La cantidad de bultos debe estar entre 1 y 20.")]
        public int CantidadBultos { get; set; } = 1;

        public bool Fragil { get; set; }
    }
}
