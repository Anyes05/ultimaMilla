@page "/devoluciones"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = Plataforma.Domain.Roles.Comercio)]
@using Plataforma.Application
@using Plataforma.Domain
@inject IHttpContextAccessor HttpContextAccessor
@inject ListarEnvios ListarEnvios
@inject IBultoRepositorio Bultos
@inject IHistorialEstadoRepositorio Historial

<PageTitle>Devoluciones</PageTitle>

<div class="mb-4">
    <p class="text-uppercase text-primary fw-semibold small mb-1">Portal de comercio</p>
    <h1 class="display-6 fw-bold mb-1">Devoluciones</h1>
    <p class="text-muted mb-0">Envíos que no se pudieron entregar y vuelven, o ya volvieron, a tu comercio.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm"><div class="card-body p-3"><span class="small text-muted d-block">En devolución</span><strong class="fs-3" data-total="en-devolucion">@filas.Count(f => f.Envio.Estado == EstadoEnvio.EnDevolucion)</strong></div></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm"><div class="card-body p-3"><span class="small text-muted d-block">Devueltos</span><strong class="fs-3" data-total="devueltos">@filas.Count(f => f.Envio.Estado == EstadoEnvio.Devuelto)</strong></div></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm"><div class="card-body p-3"><span class="small text-muted d-block">Con bultos devueltos</span><strong class="fs-3" data-total="parciales">@filas.Count(f => f.Envio.Estado is not (EstadoEnvio.EnDevolucion or EstadoEnvio.Devuelto))</strong></div></div></div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th>N° Tracking</th><th>Destinatario</th><th>Estado</th><th>Bultos devueltos</th><th>Último motivo</th><th>Devuelto el</th></tr>
            </thead>
            <tbody>
            @if (filas.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-5">No tenés envíos en devolución.</td></tr>
            }
            @foreach (var fila in filas)
            {
                <tr>
                    <td><span class="tracking-number">@fila.Envio.NumeroSeguimiento</span></td>
                    <td>@fila.Envio.Destinatario</td>
                    <td><span class="status-badge @EstadosVista.Clase(fila.Envio.Estado)">@EstadosVista.Nombre(fila.Envio.Estado)</span></td>
                    <td>@fila.BultosDevueltos de @fila.BultosTotal</td>
                    <td class="small">@(fila.Motivo ?? "—")</td>
                    <td>@(fila.DevueltoEl?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<FilaDevolucion> filas = [];

    protected override async Task OnInitializedAsync()
    {
        var principal = HttpContextAccessor.HttpContext?.User ?? new System.Security.Claims.ClaimsPrincipal();
        if (!AccesoActual.Intentar(principal, out var acceso) || acceso.Rol != Roles.Comercio || acceso.ComercioId is null)
            return;

        // ListarEnvios ya filtra por el comercio autenticado.
        var envios = await ListarEnvios.Ejecutar(acceso);
        var historial = (await Historial.ListarPorEnviosAsync(acceso.OperadorId, envios.Select(envio => envio.Id).ToList()))
            .GroupBy(evento => evento.EnvioId)
            .ToDictionary(grupo => grupo.Key, grupo => grupo.ToList());

        foreach (var envio in envios)
        {
            var bultos = await Bultos.ListarPorEnvioAsync(acceso.OperadorId, envio.Id);
            var devueltos = bultos.Count(bulto => bulto.Estado == EstadoBulto.Devuelto);
            if (envio.Estado is not (EstadoEnvio.EnDevolucion or EstadoEnvio.Devuelto) && devueltos == 0)
                continue;

            var eventos = historial.TryGetValue(envio.Id, out var lista) ? lista : [];
            var motivo = eventos.Where(evento => evento.Estado == EstadoEnvio.NoEntregado && !string.IsNullOrWhiteSpace(evento.Motivo))
                .OrderByDescending(evento => evento.Fecha)
                .Select(evento => evento.Motivo)
                .FirstOrDefault()
                ?? bultos.Select(bulto => bulto.MotivoNoEntrega).FirstOrDefault(texto => !string.IsNullOrWhiteSpace(texto));
            var devuelto = eventos.Where(evento => evento.Estado == EstadoEnvio.Devuelto).Select(evento => (DateTime?)evento.Fecha).Max();
            filas.Add(new FilaDevolucion(envio, devueltos, bultos.Count, motivo, devuelto is null ? null : DateTime.SpecifyKind(devuelto.Value, DateTimeKind.Utc)));
        }

        filas = filas.OrderByDescending(fila => fila.DevueltoEl ?? fila.Envio.FechaCreacion).ToList();
    }

    private sealed record FilaDevolucion(Envio Envio, int BultosDevueltos, int BultosTotal, string? Motivo, DateTime? DevueltoEl);
}
