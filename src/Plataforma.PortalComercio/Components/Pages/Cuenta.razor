@page "/cuenta"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = Plataforma.Domain.Roles.Comercio)]
@using Plataforma.Application
@using Plataforma.Domain
@inject IHttpContextAccessor HttpContextAccessor
@inject ListarEnvios ListarEnvios
@inject GestionLiquidaciones Liquidaciones
@inject IOperadorRepositorio Operadores

<PageTitle>Cuenta corriente</PageTitle>

<div class="mb-4">
    <p class="text-uppercase text-primary fw-semibold small mb-1">Portal de comercio</p>
    <h1 class="display-6 fw-bold mb-1">Cuenta corriente</h1>
    <p class="text-muted mb-0">Lo que se te cobra por tus envíos y las liquidaciones del operador.</p>
</div>

<form method="get" class="d-flex flex-wrap align-items-end gap-2 mb-4">
    <div>
        <label class="form-label fw-semibold" for="mes">Mes</label>
        <input id="mes" name="mes" type="month" class="form-control" value="@periodo.ToString("yyyy-MM")" />
    </div>
    <button class="btn btn-primary" type="submit">Ver</button>
</form>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body p-3"><span class="small text-muted d-block">Cargos del mes (entregados)</span><strong class="fs-4" data-total="cargos">@Importe(cargos)</strong></div></div></div>
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body p-3"><span class="small text-muted d-block">En curso (se cobran al entregar)</span><strong class="fs-4" data-total="en-curso">@Importe(enCurso)</strong></div></div></div>
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body p-3"><span class="small text-muted d-block">Sin cargo (devueltos o extraviados)</span><strong class="fs-4" data-total="sin-cargo">@Importe(sinCargo)</strong></div></div></div>
</div>

<h2 class="h5 mb-3">Movimientos del mes</h2>
<div class="card border-0 shadow-sm mb-4">
    <div class="table-responsive" style="max-height: 420px">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Fecha</th><th>N° Tracking</th><th>Estado</th><th class="text-end">Tarifa</th><th>Cargo</th></tr></thead>
            <tbody>
            @if (movimientos.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-4">No hay envíos en ese mes.</td></tr>
            }
            @foreach (var envio in movimientos)
            {
                <tr>
                    <td>@Local(envio.FechaCreacion).ToString("dd/MM/yyyy")</td>
                    <td><span class="tracking-number">@envio.NumeroSeguimiento</span></td>
                    <td><span class="status-badge @EstadosVista.Clase(envio.Estado)">@EstadosVista.Nombre(envio.Estado)</span></td>
                    <td class="text-end">@Importe(envio.TarifaCalculada)</td>
                    <td>@(envio.Estado == EstadoEnvio.Entregado ? "Se cobra" : envio.Estado is EstadoEnvio.Devuelto or EstadoEnvio.Extraviado ? "Sin cargo" : "Pendiente")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<h2 class="h5 mb-3">Liquidaciones</h2>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Período</th><th class="text-end">Monto</th><th>Estado</th></tr></thead>
            <tbody>
            @if (liquidaciones.Count == 0)
            {
                <tr><td colspan="3" class="text-center text-muted py-4">El operador todavía no te liquidó ningún período.</td></tr>
            }
            @foreach (var liquidacion in liquidaciones)
            {
                <tr>
                    <td>@Local(liquidacion.PeriodoDesde).ToString("dd/MM/yyyy") al @Local(liquidacion.PeriodoHasta).ToString("dd/MM/yyyy")</td>
                    <td class="text-end">@Importe(liquidacion.Monto)</td>
                    <td><span class="status-badge @(liquidacion.Cerrada ? "status-entregado" : "status-en-transito")">@(liquidacion.Cerrada ? "Cerrada" : "Abierta")</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "mes")]
    private string? Mes { get; set; }

    private DateOnly periodo;
    private TimeZoneInfo zona = TimeZoneInfo.Utc;
    private List<Envio> movimientos = [];
    private IReadOnlyList<Liquidacion> liquidaciones = [];
    private decimal cargos;
    private decimal enCurso;
    private decimal sinCargo;

    protected override async Task OnInitializedAsync()
    {
        var principal = HttpContextAccessor.HttpContext?.User ?? new System.Security.Claims.ClaimsPrincipal();
        if (!AccesoActual.Intentar(principal, out var acceso) || acceso.Rol != Roles.Comercio || acceso.ComercioId is not Guid comercioId)
            return;

        var operador = await Operadores.ObtenerAsync(acceso.OperadorId);
        if (operador is not null)
            zona = ObtenerReportesGestion.Zona(operador);

        var hoy = operador?.DiaActual() ?? DateOnly.FromDateTime(DateTime.UtcNow);
        periodo = DateOnly.TryParseExact((Mes ?? string.Empty) + "-01", "yyyy-MM-dd", out var elegido) ? elegido : new DateOnly(hoy.Year, hoy.Month, 1);
        var desde = ObtenerReportesGestion.AUtc(periodo.ToDateTime(TimeOnly.MinValue), zona);
        var hasta = ObtenerReportesGestion.AUtc(periodo.AddMonths(1).ToDateTime(TimeOnly.MinValue), zona);

        movimientos = (await ListarEnvios.Ejecutar(acceso))
            .Where(envio => envio.FechaCreacion >= desde && envio.FechaCreacion < hasta)
            .OrderByDescending(envio => envio.FechaCreacion)
            .ToList();
        cargos = movimientos.Where(envio => envio.Estado == EstadoEnvio.Entregado).Sum(envio => envio.TarifaCalculada);
        sinCargo = movimientos.Where(envio => envio.Estado is EstadoEnvio.Devuelto or EstadoEnvio.Extraviado).Sum(envio => envio.TarifaCalculada);
        enCurso = movimientos.Sum(envio => envio.TarifaCalculada) - cargos - sinCargo;

        // Solo las del propio comercio: el caso de uso filtra por comercio.
        liquidaciones = (await Liquidaciones.ListarAsync(acceso.OperadorId, comercioId))
            .OrderByDescending(liquidacion => liquidacion.PeriodoHasta)
            .ToList();
    }

    private DateTime Local(DateTime utc) => ObtenerReportesGestion.ALocal(utc, zona);

    private static string Importe(decimal valor) =>
        valor.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-UY"));
}
