@page "/seguimiento"
@page "/seguimiento/{Token}"
@using Plataforma.Application
@using Plataforma.Domain
@using Microsoft.EntityFrameworkCore
@inject ObtenerDetalleSeguimiento ObtenerSeguimiento
@inject SolicitarReprogramacion Reprogramacion
@inject NavigationManager Navegacion

@* Seguimiento público del destinatario (RF 25, letra 6.2): SSR estático, sin sesión y sin datos personales.
   Se entra con el enlace que recibe el destinatario (/seguimiento/{token}) o con el número de seguimiento. *@

<PageTitle>Seguimiento de envío</PageTitle>
<HeadContent>
    @* Un seguimiento no debe aparecer en buscadores. *@
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

@* Sin resultado, el buscador queda centrado en la pantalla; con resultado, arriba y la información debajo. *@
<div class="row justify-content-center @(visible is null ? "seguimiento-centrado" : null)">
    <div class="col-md-10 col-lg-7">
        <section class="seguimiento-hero text-white rounded-4 p-4 p-md-5 mb-4">
            <p class="seguimiento-hero__etiqueta text-uppercase fw-semibold small mb-1">Seguimiento</p>
            <h1 class="h2 fw-bold mb-1">¿Dónde está mi envío?</h1>
            <p class="seguimiento-hero__texto mb-4">Consultá el estado con el enlace que recibiste o con tu número de seguimiento.</p>

            <form method="get" action="/seguimiento" class="bg-white text-body rounded-3 shadow p-3">
                <label class="form-label fw-semibold" for="numero">Número de seguimiento</label>
                <div class="input-group">
                    @* Si no se encontró, el campo vuelve vacío con la sugerencia; el número buscado se nombra en el aviso. *@
                    <input id="numero" name="numero" value="@(noEncontrado ? null : Numero)" class="form-control form-control-lg"
                           placeholder="Ej.: ENV-1A2B3C4D…" autocomplete="off" maxlength="64" aria-describedby="numero-ayuda" />
                    <button class="btn btn-primary" type="submit">Consultar</button>
                </div>
                <div id="numero-ayuda" class="form-text">Está en el mensaje o correo que recibiste del envío y empieza con ENV-.</div>
            </form>
        </section>

        @if (noEncontrado)
        {
            <div class="alert alert-warning" role="alert">
                No encontramos un envío con el seguimiento <strong class="tracking-number">@(Numero ?? "del enlace")</strong>. Revisá el número o el enlace que recibiste.
            </div>
        }

        @if (Reprogramada)
        {
            <div class="alert alert-success" role="alert">Listo: pedimos otra visita para tu envío.</div>
        }

        @if (mensajeError is not null)
        {
            <div class="alert alert-warning" role="alert">@mensajeError</div>
        }

        @if (visible is not null)
        {
            var etapa = SeguimientoPublico.EtapaActual(visible.Estado);
            @* --marca: color del operador; pinta la cabecera, las etapas, la entrega prevista y el historial. *@
            <article class="card border-0 shadow seguimiento-tarjeta overflow-hidden" aria-labelledby="estado-titulo"
                     style="--marca: @SeguimientoPublico.ColorMarcaCss(visible.ColorMarca)">
                <div class="seguimiento-tarjeta__cabecera p-4">
                    <p class="seguimiento-marca small fw-semibold mb-3">
                        <span class="seguimiento-marca__color" aria-hidden="true"></span>
                        @visible.Operador
                    </p>
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div class="min-w-0">
                            <span class="small text-muted d-block">Número de seguimiento</span>
                            <strong class="tracking-number fs-5">@visible.NumeroSeguimiento</strong>
                        </div>
                        <span class="status-badge @EstadosVista.Clase(visible.Estado)">@EstadosVista.Nombre(visible.Estado)</span>
                    </div>

                    <h2 id="estado-titulo" class="h5 fw-bold mb-0">@SeguimientoPublico.Descripcion(visible.Estado)</h2>
                </div>
                <div class="card-body p-4">

                    @if (etapa >= 0)
                    {
                        <ol class="seguimiento-etapas" aria-label="Recorrido del envío">
                            @for (var i = 0; i < SeguimientoPublico.Etapas.Count; i++)
                            {
                                var clase = i < etapa ? "completa" : i == etapa ? "actual" : "pendiente";
                                <li class="seguimiento-etapa @clase" aria-current="@(i == etapa ? "step" : null)">
                                    <span class="seguimiento-etapa__punto" aria-hidden="true"></span>
                                    <span class="seguimiento-etapa__nombre">@SeguimientoPublico.Etapas[i].Nombre</span>
                                </li>
                            }
                        </ol>
                    }

                    @if (visible.FechaPrevista is DateOnly fechaPrevista)
                    {
                        <p class="seguimiento-dato rounded-3 p-3 mt-4 mb-0">Entrega prevista: <strong>@fechaPrevista.ToString("dd/MM/yyyy")</strong></p>
                    }
                    else if (visible.EstimadaAntesDeUtc is DateTime antesDe)
                    {
                        <p class="seguimiento-dato rounded-3 p-3 mt-4 mb-0">Entrega estimada antes del <strong>@HoraLocal(antesDe)</strong></p>
                    }

                    @if (visible.BultosTotal > 1)
                    {
                        <p class="small mt-3 mb-0">@visible.BultosEntregados de @visible.BultosTotal bultos entregados.</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(visible.TelefonoContacto) || !string.IsNullOrWhiteSpace(visible.EmailContacto))
                    {
                        <p class="small text-muted mt-3 mb-0" data-contacto-operador>
                            ¿Consultas? Comunicate con @visible.Operador:
                            @if (!string.IsNullOrWhiteSpace(visible.TelefonoContacto))
                            {
                                <a href="tel:@visible.TelefonoContacto">@visible.TelefonoContacto</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(visible.TelefonoContacto) && !string.IsNullOrWhiteSpace(visible.EmailContacto))
                            {
                                <span> · </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(visible.EmailContacto))
                            {
                                <a href="mailto:@visible.EmailContacto">@visible.EmailContacto</a>
                            }
                        </p>
                    }

                    @if (visible.IntentosRealizados > 0)
                    {
                        <p class="small text-muted mt-3 mb-0">Intentos de entrega realizados: @visible.IntentosRealizados</p>
                    }

                    @* El formulario se dibuja siempre con enlace: si no, repetir el pedido desde una pestaña vieja da un 400 sin explicación. *@
                    @if (TokenActual is not null)
                    {
                        <form method="post" class="mt-4" @onsubmit="PedirOtraVisita" @formname="reprogramar-envio">
                            <AntiforgeryToken />
                            @if (visible.PuedeReprogramar)
                            {
                                <button type="submit" class="btn btn-primary w-100">Pedir otra visita</button>
                            }
                        </form>
                    }
                    else if (visible.PuedeReprogramar)
                    {
                        <p class="small text-muted mt-4 mb-0">Para pedir otra visita, abrí el enlace que recibiste.</p>
                    }

                    @if (visible.Historial.Count > 0)
                    {
                        <h3 class="h6 mt-4 mb-2">Historial</h3>
                        <ol class="seguimiento-historial small">
                            @foreach (var evento in visible.Historial.OrderByDescending(item => item.Fecha))
                            {
                                <li>
                                    <span>@EstadosVista.Nombre(evento.Estado)</span>
                                    <span class="text-muted">@HoraLocal(evento.Fecha)</span>
                                    @if (!string.IsNullOrWhiteSpace(evento.Motivo))
                                    {
                                        <span class="d-block text-muted">@evento.Motivo</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(evento.Responsable))
                                    {
                                        <span class="d-block text-muted">Responsable: @evento.Responsable</span>
                                    }
                                </li>
                            }
                        </ol>
                    }
                </div>
            </article>
        }
    </div>
</div>

@code {
    /// <summary>Token del enlace público (ruta /seguimiento/{token}).</summary>
    [Parameter]
    public string? Token { get; set; }

    /// <summary>Compatibilidad con enlaces del formato anterior (/Seguimiento?token=...).</summary>
    [SupplyParameterFromQuery(Name = "token")]
    public string? TokenConsulta { get; set; }

    [SupplyParameterFromQuery(Name = "numero")]
    public string? Numero { get; set; }

    [SupplyParameterFromQuery(Name = "reprogramada")]
    public bool Reprogramada { get; set; }

    private DetalleSeguimiento? visible;
    private bool noEncontrado;
    private string? mensajeError;

    private string? TokenActual => string.IsNullOrWhiteSpace(Token)
        ? string.IsNullOrWhiteSpace(TokenConsulta) ? null : TokenConsulta
        : Token;

    protected override async Task OnInitializedAsync()
    {
        // El caso de uso ya usa caché distribuido (seguimiento: lectura muy frecuente, cambia seguido).
        if (TokenActual is { } token)
            visible = await ObtenerSeguimiento.PorTokenAsync(token);
        else if (!string.IsNullOrWhiteSpace(Numero))
            visible = await ObtenerSeguimiento.PorNumeroAsync(Numero);
        else
            return;

        noEncontrado = visible is null;
    }

    private async Task PedirOtraVisita()
    {
        if (TokenActual is not { } token)
            return;

        ResultadoReprogramacion resultado;
        try
        {
            resultado = await Reprogramacion.EjecutarAsync(token);
        }
        catch (Exception ex) when (ex is InvalidOperationException or DbUpdateConcurrencyException)
        {
            // Otra persona o el operador lo cambió justo antes.
            resultado = ResultadoReprogramacion.NoPermitida;
        }

        if (resultado != ResultadoReprogramacion.Realizada)
        {
            mensajeError = "No pudimos pedir otra visita para este envío. Comunicate con el comercio.";
            return;
        }

        Navegacion.NavigateTo($"/seguimiento/{Uri.EscapeDataString(token)}?reprogramada=true", forceLoad: true);
    }

    private string HoraLocal(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(utc, DateTimeKind.Utc),
            TimeZoneInfo.FindSystemTimeZoneById(visible!.ZonaHoraria)).ToString("dd/MM/yyyy HH:mm");
}
