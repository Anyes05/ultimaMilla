@page "/login"
@using Plataforma.Domain

<PageTitle>Ingresar</PageTitle>

<div class="row justify-content-center align-items-center min-vh-75">
    <div class="col-sm-10 col-md-6 col-lg-4">
        <div class="text-center mb-4">
            <p class="text-uppercase text-primary fw-semibold small mb-1">Portal de comercio</p>
            <h1 class="h2 fw-bold">Ingresá a tu cuenta</h1>
            <p class="text-muted">Gestioná tus envíos en un solo lugar.</p>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                @if (Error)
                {
                    <div class="alert alert-danger">Usuario o contraseña incorrectos.</div>
                }
                <form method="post" action="/session/login">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="usuario">Usuario</label>
                        <input id="usuario" name="usuario" class="form-control form-control-lg" autocomplete="username" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="clave">Contraseña</label>
                        <input id="clave" name="clave" type="password" class="form-control form-control-lg" autocomplete="current-password" required />
                    </div>
                    <button class="btn btn-primary btn-lg w-100" type="submit">Ingresar</button>
                </form>
                <p class="small text-muted mt-3 mb-0">Demo: norte.comercio / Demo123!</p>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorQuery { get; set; }

    private bool Error => ErrorQuery == "1";
}
