@page "/retiros"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = Plataforma.Domain.Roles.Comercio)]
@using Plataforma.Application
@using Plataforma.Domain
@inject IHttpContextAccessor HttpContextAccessor
@inject GestionRetiros GestionRetiros
@inject IBanderasOperador Banderas
@inject IOperadorRepositorio Operadores
@inject GestionCobertura Cobertura
@inject NavigationManager Navegacion
@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider Proteccion

<PageTitle>Retiros</PageTitle>

<div class="mb-4">
    <p class="text-uppercase text-primary fw-semibold small mb-1">Portal de comercio</p>
    <h1 class="display-6 fw-bold mb-1">Retiros en domicilio</h1>
    <p class="text-muted mb-0">Pedí que pasemos a buscar tus paquetes.</p>
</div>

@if (!string.IsNullOrWhiteSpace(Ok))
{
    <div class="alert alert-success" role="status">@(Ok == "cancelado" ? "Retiro cancelado." : "Retiro solicitado.")</div>
}
@if (mensajeError is not null)
{
    <div class="alert alert-danger" role="alert">@mensajeError</div>
}

@* En un POST se renderiza siempre: si la bandera se apagó entre medio, Blazor necesita el formulario y el caso de uso avisa. *@
@if (habilitado || HttpMethods.IsPost(HttpContextAccessor.HttpContext?.Request.Method ?? string.Empty))
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h2 class="h5 mb-4">Solicitar un retiro</h2>
            <EditForm method="post" Model="Formulario" OnValidSubmit="SolicitarAsync" FormName="SolicitarRetiroForm">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger py-2" />
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label fw-semibold" for="direccion">Dirección de retiro</label>
                        <InputText id="direccion" @bind-Value="Formulario!.Direccion" class="form-control" placeholder="Calle, número y localidad" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="fecha">Fecha</label>
                        <InputDate id="fecha" @bind-Value="Formulario!.Fecha" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="franja">Franja horaria <span class="text-muted fw-normal">(opcional)</span></label>
                        <InputSelect id="franja" @bind-Value="Formulario!.FranjaId" class="form-select">
                            <option value="">Cualquier horario</option>
                            @foreach (var franja in franjas)
                            {
                                <option value="@franja.Id">@franja.Nombre (@franja.Desde.ToString("HH:mm") a @franja.Hasta.ToString("HH:mm"))</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="motivo">Motivo</label>
                        <InputSelect id="motivo" @bind-Value="Formulario!.Motivo" class="form-select">
                            <option value="">Elegí un motivo</option>
                            @foreach (var motivo in SolicitudRetiro.MotivosSugeridos)
                            {
                                <option value="@motivo">@motivo</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="contacto">Contacto <span class="text-muted fw-normal">(opcional)</span></label>
                        <InputText id="contacto" @bind-Value="Formulario!.Contacto" class="form-control" placeholder="Nombre o teléfono" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="bultos">Bultos</label>
                        <InputNumber id="bultos" @bind-Value="Formulario!.CantidadBultos" class="form-control" min="1" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="peso">Peso estimado (kg)</label>
                        <InputNumber id="peso" @bind-Value="Formulario!.PesoKg" class="form-control" min="0" step="0.1" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="volumen">Volumen estimado (cm³) <span class="text-muted fw-normal">(opcional)</span></label>
                        <InputNumber id="volumen" @bind-Value="Formulario!.VolumenCm3" class="form-control" min="0" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-semibold" for="observaciones">Observaciones <span class="text-muted fw-normal">(opcional)</span></label>
                        <InputText id="observaciones" @bind-Value="Formulario!.Observaciones" class="form-control" />
                    </div>
                </div>
                @if (cotizacion is not null)
                {
                    <p class="small text-muted mt-3 mb-0" data-costo-retiro>
                        Costo del retiro: <strong>@Importe(cotizacion.Importe)</strong>
                        @if (cotizacion.Bonificacion is not null)
                        {
                            <span>(incluye bonificación "@cotizacion.Bonificacion")</span>
                        }
                    </p>
                }
                <button type="submit" class="btn btn-primary mt-3">Solicitar retiro</button>
            </EditForm>
        </div>
    </div>
}
else
{
    <div class="alert alert-info" role="status">El retiro en domicilio no está habilitado por tu operador.</div>
}

<section aria-labelledby="retiros-titulo">
    <h2 id="retiros-titulo" class="h4 fw-bold mb-3">Mis retiros</h2>
    @* Un solo formulario: Blazor exige nombres únicos, y cada botón manda el retiro que cancela. *@
    <form method="post" @onsubmit="CancelarAsync" @formname="CancelarRetiroForm">
        <AntiforgeryToken />
        @if (retiros.Count == 0)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center text-muted py-5">Todavía no pediste retiros.</div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Dirección</th>
                                <th>Contacto</th>
                                <th class="text-end">Tarifa</th>
                                <th>Estado</th>
                                <th>Seguimiento</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var retiro in retiros)
                            {
                                <tr @key="retiro.Id">
                                    <td>@retiro.FechaSolicitada.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @retiro.Direccion
                                        <span class="d-block small text-muted">@retiro.CantidadBultos bulto(s)@(retiro.PesoKg > 0 ? $" · {retiro.PesoKg:0.##} kg" : "")@(string.IsNullOrWhiteSpace(retiro.Motivo) ? "" : $" · {retiro.Motivo}")@NombreFranja(retiro.FranjaId)</span>
                                        @if (retiro.Estado == EstadoRetiro.NoRetirado && !string.IsNullOrWhiteSpace(retiro.MotivoNoRetiro))
                                        {
                                            <span class="d-block small text-danger">No retirado: @retiro.MotivoNoRetiro</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(retiro.Contacto) ? "—" : retiro.Contacto)</td>
                                    <td class="text-end">@Importe(retiro.TarifaCalculada)</td>
                                    <td><span class="status-badge @ClaseEstado(retiro.Estado)">@NombreEstado(retiro.Estado)</span></td>
                                    <td>
                                        <a href="/seguimiento/retiro/@SeguimientoPublico.TokenRetiro(Proteccion, retiro.OperadorId, retiro.Id)" target="_blank" rel="noopener">Ver enlace</a>
                                        @if (retiro.Estado is EstadoRetiro.Solicitado or EstadoRetiro.Programado or EstadoRetiro.EnCurso or EstadoRetiro.NoRetirado)
                                        {
                                            <a class="d-block small" href="/retiros/@retiro.Id/etiquetas" data-etiquetas-retiro>Etiquetas QR</a>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (retiro.Estado is EstadoRetiro.Solicitado or EstadoRetiro.Programado)
                                        {
                                            <button type="submit" name="RetiroACancelar" value="@retiro.Id" class="btn btn-sm btn-outline-danger">Cancelar</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </form>
</section>

@code {
    [SupplyParameterFromForm(FormName = "SolicitarRetiroForm")]
    private RetiroForm? Formulario { get; set; }

    [SupplyParameterFromForm(FormName = "CancelarRetiroForm")]
    private Guid? RetiroACancelar { get; set; }

    [SupplyParameterFromQuery(Name = "ok")]
    private string? Ok { get; set; }

    private IReadOnlyList<SolicitudRetiro> retiros = [];
    private bool habilitado;
    private string? mensajeError;
    private DateOnly hoy;
    private ResultadoTarifa? cotizacion;
    private IReadOnlyList<FranjaHoraria> franjas = [];

    private string NombreFranja(Guid? franjaId) =>
        franjaId is Guid id && franjas.FirstOrDefault(franja => franja.Id == id) is { } franja
            ? $" · {franja.Nombre} ({franja.Desde:HH\\:mm} a {franja.Hasta:HH\\:mm})"
            : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Formulario ??= new();
        if (!IntentarObtenerAcceso(out var acceso, out var comercioId))
        {
            mensajeError = "No se pudo identificar el comercio autenticado. Volvé a iniciar sesión.";
            return;
        }

        var operador = await Operadores.ObtenerAsync(acceso.OperadorId);
        hoy = operador?.DiaActual() ?? DateOnly.FromDateTime(DateTime.UtcNow);
        if (Formulario.Fecha == default)
            Formulario.Fecha = hoy.AddDays(1);

        habilitado = await Banderas.EstaActivaAsync(acceso.OperadorId, CatalogoBanderas.RetiroDomicilio);
        if (habilitado)
            cotizacion = await GestionRetiros.CotizarAsync(acceso.OperadorId, comercioId);
        franjas = await Cobertura.ListarFranjasAsync(acceso.OperadorId);
        await CargarAsync(acceso.OperadorId, comercioId);
    }

    private async Task SolicitarAsync()
    {
        Formulario ??= new();
        if (!IntentarObtenerAcceso(out var acceso, out var comercioId))
            return;

        if (Formulario.Fecha < hoy)
        {
            mensajeError = "La fecha del retiro no puede ser anterior a hoy.";
            return;
        }

        try
        {
            await GestionRetiros.SolicitarAsync(
                acceso.OperadorId, comercioId, Formulario.Direccion, Formulario.Contacto ?? string.Empty,
                Formulario.Fecha, Formulario.Observaciones ?? string.Empty,
                cantidadBultos: Formulario.CantidadBultos ?? 1, pesoKg: Formulario.PesoKg ?? 0, volumenCm3: Formulario.VolumenCm3 ?? 0,
                franjaId: Formulario.FranjaId, motivo: Formulario.Motivo ?? string.Empty);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            mensajeError = TextosUsuario.Error(ex);
            return;
        }

        Navegacion.NavigateTo("/retiros?ok=solicitado", forceLoad: true);
    }

    private async Task CancelarAsync()
    {
        if (RetiroACancelar is not Guid id || !IntentarObtenerAcceso(out var acceso, out _))
            return;

        // Solo los del propio comercio: la lista ya viene filtrada.
        if (retiros.All(retiro => retiro.Id != id))
        {
            mensajeError = "El retiro no existe.";
            return;
        }

        try
        {
            await GestionRetiros.CancelarAsync(acceso.OperadorId, id, "Cancelado por el comercio");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            mensajeError = TextosUsuario.Error(ex);
            return;
        }

        Navegacion.NavigateTo("/retiros?ok=cancelado", forceLoad: true);
    }

    private async Task CargarAsync(Guid operadorId, Guid comercioId) =>
        retiros = (await GestionRetiros.ListarAsync(operadorId, comercioId))
            .OrderByDescending(retiro => retiro.FechaSolicitada)
            .ThenByDescending(retiro => retiro.CreadoEn)
            .ToList();

    private bool IntentarObtenerAcceso(out AccesoActual acceso, out Guid comercioId)
    {
        comercioId = Guid.Empty;
        var principal = HttpContextAccessor.HttpContext?.User ?? new System.Security.Claims.ClaimsPrincipal();
        if (!AccesoActual.Intentar(principal, out acceso) || acceso.Rol != Roles.Comercio || acceso.ComercioId is not Guid comercio)
            return false;

        comercioId = comercio;
        return true;
    }

    private static string Importe(decimal valor) =>
        valor.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-UY"));

    private static string NombreEstado(EstadoRetiro estado) => estado switch
    {
        EstadoRetiro.EnCurso => "En curso",
        EstadoRetiro.Completado => "Retirado",
        EstadoRetiro.NoRetirado => "No retirado",
        EstadoRetiro.EnDeposito => "En depósito",
        _ => estado.ToString()
    };

    private static string ClaseEstado(EstadoRetiro estado) => estado switch
    {
        EstadoRetiro.Solicitado => "status-admitido",
        EstadoRetiro.Programado => "status-asignado-a-ruta",
        EstadoRetiro.EnCurso => "status-en-transito",
        EstadoRetiro.Completado => "status-entregado",
        EstadoRetiro.EnDeposito => "status-en-deposito",
        EstadoRetiro.NoRetirado => "status-no-entregado",
        _ => "status-extraviado"
    };

    public class RetiroForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La dirección es requerida.")]
        [System.ComponentModel.DataAnnotations.StringLength(300, ErrorMessage = "La dirección es demasiado larga.")]
        public string Direccion { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.StringLength(120, ErrorMessage = "El contacto es demasiado largo.")]
        public string? Contacto { get; set; }

        [System.ComponentModel.DataAnnotations.StringLength(500, ErrorMessage = "Las observaciones son demasiado largas.")]
        public string? Observaciones { get; set; }

        public DateOnly Fecha { get; set; }

        [System.ComponentModel.DataAnnotations.Range(1, 100, ErrorMessage = "Los bultos deben ser entre 1 y 100.")]
        public int? CantidadBultos { get; set; } = 1;

        [System.ComponentModel.DataAnnotations.Range(typeof(decimal), "0", "5000", ErrorMessage = "El peso debe estar entre 0 y 5000 kg.")]
        public decimal? PesoKg { get; set; }

        [System.ComponentModel.DataAnnotations.Range(typeof(decimal), "0", "100000000", ErrorMessage = "El volumen no puede ser negativo.")]
        public decimal? VolumenCm3 { get; set; }

        public Guid? FranjaId { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Elegí el motivo del retiro.")]
        public string? Motivo { get; set; }
    }
}
