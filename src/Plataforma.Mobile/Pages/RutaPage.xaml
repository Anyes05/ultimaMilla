<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Plataforma.Mobile.ViewModels"
             xmlns:models="clr-namespace:Plataforma.Mobile.Models"
             x:Class="Plataforma.Mobile.Pages.RutaPage"
             x:DataType="vm:RutaViewModel"
             HideSoftInputOnTapped="True"
             SafeAreaEdges="All"
             Title="Ruta del dia">
    <Grid Padding="12,8" MaximumWidthRequest="760" HorizontalOptions="Fill">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" IsVisible="{Binding MostrarRuta}">
        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="MI JORNADA" Style="{StaticResource SectionLabel}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="⋮" Command="{Binding AlternarMenuCommand}"
                    Style="{StaticResource SecondaryButton}" FontSize="24" WidthRequest="52"
                    SemanticProperties.Description="Abrir menu de jornada" />
            </Grid>
            <Label Text="{Binding Titulo}" Style="{StaticResource HeadingLabel}" FontSize="22" />
            <Label Text="{Binding Resumen}" AutomationId="RutaResumen" FontAttributes="Bold" />
            <Label Text="{Binding EstadoPush}" Style="{StaticResource MutedLabel}" />
                <Label Text="{Binding EstadoInicioRuta}" Style="{StaticResource MutedLabel}" />
                <Button Text="Iniciar ruta" Command="{Binding IniciarRutaCommand}"
                    IsVisible="{Binding PuedeIniciarRuta}" Style="{StaticResource SecondaryButton}" />
            <VerticalStackLayout IsVisible="{Binding RecorridoActivo}" Spacing="6">
                <Label Text="{Binding ProgresoRecorrido}" Style="{StaticResource SectionLabel}" />
                <Button Text="Siguiente parada" Command="{Binding SiguienteParadaCommand}" Style="{StaticResource SecondaryButton}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="Anterior" Command="{Binding ParadaAnteriorCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Grid.Column="1" Text="Pausar recorrido" Command="{Binding PausarRecorridoCommand}" Style="{StaticResource SecondaryButton}" />
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
        <Label Grid.Row="1" Text="{Binding Mensaje}" AutomationId="RutaMensaje"
               SemanticProperties.Description="{Binding Mensaje}">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding Mensaje}" Value="">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Label.Triggers>
        </Label>
        <CollectionView Grid.Row="2" ItemsSource="{Binding EnviosVisibles}" SelectionMode="None" ItemSizingStrategy="MeasureAllItems">
            <CollectionView.Footer>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Retiros}" Spacing="8" Margin="0,12,0,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:RetiroEnRuta">
                            <Border Padding="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="RETIRO EN DOMICILIO" Style="{StaticResource SectionLabel}" />
                                    <Label Text="{Binding Direccion}" FontAttributes="Bold" />
                                    <Label Text="{Binding Contacto}" />
                                    <Label Text="{Binding ParadaTexto}" Style="{StaticResource MutedLabel}" />
                                    <Label Text="{Binding EstadoTexto}" />
                                    <Button Text="Registrar retiro" IsVisible="{Binding PuedeRetirar}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RutaViewModel}}, Path=SeleccionarRetiroCommand}"
                                        CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Envio">
                    <Border Padding="12" Margin="0,4">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding NumeroSeguimiento}" FontAttributes="Bold" FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Text="{Binding Destinatario}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Direccion}" Style="{StaticResource MutedLabel}" FontSize="14" />
                            <Label Text="{Binding EstadoServidorTexto}" Style="{StaticResource EnvioStatusLabel}" />
                            <Label Text="{Binding ResumenBultos}" Style="{StaticResource MutedLabel}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ResumenBultos}" Value="">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding EstadoLocalTexto}" FontAttributes="Bold" LineBreakMode="WordWrap">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding EstadoLocalTexto}" Value="">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding ComprobanteTexto}" Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ComprobanteTexto}" Value="">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Button Text="Escanear carga" IsVisible="{Binding PuedeCargar}" IsEnabled="{Binding PuedeCargar}"
                                    Clicked="EscanearCarga" CommandParameter="{Binding .}" />
                            <Button Text="Registrar entrega" IsVisible="{Binding PuedeEntregar}" IsEnabled="{Binding PuedeEntregar}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RutaViewModel}}, Path=SeleccionarEntregaCommand}"
                                    CommandParameter="{Binding .}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
            <VerticalStackLayout Grid.Row="2" IsVisible="{Binding SinEnvios}" VerticalOptions="Center"
                         HorizontalOptions="Center" Margin="24,20" Spacing="6"
                         InputTransparent="True" ZIndex="1">
                <Label Text="Hoy no tienes envios asignados" Style="{StaticResource HeadingLabel}"
                   FontSize="20" HorizontalTextAlignment="Center" />
                <Label Text="Si esperabas una ruta, revisa tu conexion y actualiza. Los comprobantes locales se conservan."
                   Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" HeightRequest="24" />
            <Button Text="Sincronizar comprobantes" Command="{Binding SincronizarCommand}"
                    Style="{StaticResource SecondaryButton}" />
            <Button Text="Actualizar ruta" Command="{Binding DescargarRutaCommand}"
                    Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>
      </Grid>
        <Border IsVisible="{Binding MenuAbierto}" HorizontalOptions="End" VerticalOptions="Start"
            Margin="0,56,12,0" Padding="8" ZIndex="10">
            <VerticalStackLayout Spacing="6">
            <Button Text="Sincronizar" Command="{Binding SincronizarCommand}"
                Style="{StaticResource SecondaryButton}" />
            <Button Text="Reintentar rechazados" Command="{Binding ReintentarRechazadosCommand}"
                Style="{StaticResource SecondaryButton}" />
            <Button Text="Historial de entregas" Command="{Binding AbrirHistorialCommand}"
                Style="{StaticResource SecondaryButton}" />
            <Button Text="Cerrar sesion" Clicked="CerrarSesion"
                Style="{StaticResource SecondaryButton}" />
            </VerticalStackLayout>
        </Border>
        <Grid IsVisible="{Binding MostrarHistorial}" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="Historial de entregas" Style="{StaticResource HeadingLabel}" FontSize="22"
                       VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Volver" Command="{Binding VolverARutaCommand}"
                        Style="{StaticResource SecondaryButton}" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <SearchBar Text="{Binding TextoFechaHistorial}" Placeholder="Filtrar por fecha (dd/MM/aaaa)"
                           Keyboard="Text" AutomationId="HistorialFiltroFecha" />
                <Button Grid.Column="1" Text="×" Command="{Binding LimpiarFiltroHistorialCommand}"
                        Style="{StaticResource SecondaryButton}" FontSize="22" WidthRequest="48"
                        SemanticProperties.Description="Limpiar filtro de fecha" />
            </Grid>
            <VerticalStackLayout Grid.Row="2" Spacing="4">
                <Label Text="{Binding ResumenHistorial}" Style="{StaticResource MutedLabel}" />
                <Label Text="{Binding MensajeFiltroHistorial}" Style="{StaticResource MutedLabel}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding MensajeFiltroHistorial}" Value="">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
            <CollectionView Grid.Row="3" ItemsSource="{Binding EntregasHistorial}" ItemSizingStrategy="MeasureAllItems"
                            RemainingItemsThreshold="2"
                            RemainingItemsThresholdReachedCommand="{Binding CargarMasHistorialCommand}">
                <CollectionView.EmptyView>
                    <Label Text="No hay entregas confirmadas para este filtro."
                           Style="{StaticResource MutedLabel}" HorizontalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:EntregaPendiente">
                        <Border Padding="12" Margin="0,4">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding NumeroSeguimiento}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Destinatario}" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding FechaTexto}" />
                                <Label Text="{Binding NombreReceptor}" />
                                <Label Text="{Binding Observaciones}" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <Grid IsVisible="{Binding HaySeleccion}"
              BackgroundColor="{AppThemeBinding Light={StaticResource AppBackground}, Dark={StaticResource AppBackgroundDark}}">
            <ScrollView>
              <Border Padding="20" VerticalOptions="Start">
                <VerticalStackLayout Spacing="12">
                    <Label Text="COMPROBANTE DE ENTREGA" Style="{StaticResource SectionLabel}" />
                    <Label Text="{Binding TituloComprobante}" Style="{StaticResource HeadingLabel}" FontSize="22" />
                    <Label Text="{Binding ReferenciaSeleccionada}" Style="{StaticResource SectionLabel}" />
                    <VerticalStackLayout IsVisible="{Binding EsRetiro}" Spacing="8">
                        <Label Text="{Binding ResumenCodigosRetiro}" />
                        <Button Text="Escanear bulto del retiro" Clicked="EscanearBultoRetiro" />
                    </VerticalStackLayout>
                    <Label Text="Nombre de quien recibe" FontAttributes="Bold" />
                    <Entry Text="{Binding NombreReceptor}" MaxLength="100"
                           Placeholder="Nombre del receptor" AutomationId="EntregaReceptor" />
                          <Label Text="Documento del receptor" FontAttributes="Bold" />
                          <Entry Text="{Binding DocumentoReceptor}" MaxLength="50"
                              Placeholder="Documento de identidad" AutomationId="EntregaDocumento" />
                    <Label Text="Observaciones de la parada" FontAttributes="Bold" />
                    <Editor Text="{Binding Observaciones}" MaxLength="500" HeightRequest="90"
                            AutomationId="EntregaObservaciones" />
                    <VerticalStackLayout IsVisible="{Binding UsaEntregaParcial}" Spacing="8">
                        <Label Text="RESULTADO POR BULTO" Style="{StaticResource SectionLabel}" />
                        <Label Text="{Binding ResumenBultosEntrega}" Style="{StaticResource MutedLabel}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding BultosEntrega}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:BultoEntregaItem">
                                    <Border Padding="12">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="{Binding Bulto.Codigo}" FontAttributes="Bold" />
                                            <Button Text="Escanear bulto entregado" Clicked="EscanearBultoEntrega"
                                                    CommandParameter="{Binding .}" IsVisible="{Binding PuedeEscanear}" />
                                                          <Label Text="Bulto escaneado" IsVisible="{Binding Entregado}"
                                                                    FontAttributes="Bold"
                                                                    TextColor="{AppThemeBinding Light=#15803D, Dark=#4ADE80}" />
                                            <Picker Title="Motivo de no entrega" ItemsSource="{Binding MotivosNoEntrega}"
                                                    SelectedItem="{Binding MotivoNoEntrega}"
                                                    IsVisible="{Binding RequiereMotivo}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout IsVisible="{Binding UsaEntregaCompleta}" Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="Intento fallido" VerticalOptions="Center" FontAttributes="Bold" />
                            <Switch Grid.Column="1" IsToggled="{Binding IntentoFallido}" />
                        </Grid>
                    </VerticalStackLayout>
                    <Label Text="{Binding EvidenciaRequeridaTexto}" Style="{StaticResource MutedLabel}" />
                    <Label Text="EVIDENCIA DE ENTREGA" Style="{StaticResource SectionLabel}" />
                    <Button Text="Tomar foto" Clicked="TomarFoto" Style="{StaticResource SecondaryButton}" />
                    <Image x:Name="VistaPreviaFoto" IsVisible="False" HeightRequest="220"
                           Aspect="AspectFit" SemanticProperties.Description="Foto adjunta al comprobante" />
                    <Label Text="La ubicacion se captura automaticamente al guardar. Activa el GPS y permite el acceso a tu ubicacion."
                           Style="{StaticResource MutedLabel}" />
                    <Label Text="Firma del receptor" FontAttributes="Bold" />
                    <Label Text="Dibuja en el recuadro. La hora se registra al guardar." Style="{StaticResource MutedLabel}" />
                    <GraphicsView x:Name="LienzoFirma" HeightRequest="180" BackgroundColor="White"
                                  StartInteraction="IniciarFirma" DragInteraction="DibujarFirma" />
                    <Button Text="Borrar firma" Clicked="BorrarFirma" Style="{StaticResource SecondaryButton}" />
                    <Label x:Name="EstadoEvidencia" />
                    <Label Text="{Binding Mensaje}" AutomationId="EntregaMensaje" />
                    <Button Text="Guardar entrega / intento pendiente" Clicked="GuardarEvidencia"
                            AutomationId="EntregaGuardar" />
                    <Button Text="Cancelar" Command="{Binding CancelarEntregaCommand}" Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
              </Border>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
