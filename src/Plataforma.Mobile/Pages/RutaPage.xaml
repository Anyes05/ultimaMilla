<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Plataforma.Mobile.ViewModels"
             xmlns:models="clr-namespace:Plataforma.Mobile.Models"
             x:Class="Plataforma.Mobile.Pages.RutaPage"
             x:DataType="vm:RutaViewModel"
             HideSoftInputOnTapped="True"
             SafeAreaEdges="All"
             Title="Ruta del dia">
    <Grid Padding="16">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8" IsVisible="{Binding MostrarRuta}">
        <VerticalStackLayout Spacing="6">
            <Label Text="ULTIMA MILLA / REPARTIDOR" Style="{StaticResource SectionLabel}" />
            <Label Text="{Binding Titulo}" Style="{StaticResource HeadingLabel}" FontSize="20" />
            <Label Text="{Binding ModoTexto}" Style="{StaticResource MutedLabel}" />
            <Label Text="Snapshot SQLite cifrado. Auto-sync con app abierta y al volver; no en app cerrada." Style="{StaticResource MutedLabel}" />
            <Entry Placeholder="Token de dispositivo (sin FCM automatico)" Text="{Binding TokenDispositivo}" />
            <HorizontalStackLayout>
                <Button Text="Alta token" Command="{Binding AltaDispositivoCommand}" />
                <Button Text="Baja token" Command="{Binding BajaDispositivoCommand}" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="10">
                <Label Text="Permitir conexion" VerticalOptions="Center" />
                <Switch IsToggled="{Binding ConexionSimulada}" AutomationId="ConexionSimulada" />
            </HorizontalStackLayout>
            <Label Text="{Binding Resumen}" AutomationId="RutaResumen" FontAttributes="Bold" />
            <Button Text="Reintentar rechazados (sin cambiar comprobantes)" Command="{Binding ReintentarRechazadosCommand}" Style="{StaticResource SecondaryButton}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="Descargar ruta" Command="{Binding DescargarRutaCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="1" Text="Volver al acceso" Command="{Binding VolverAccesoCommand}" Style="{StaticResource SecondaryButton}" />
            </Grid>
            <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" />
        </VerticalStackLayout>
        <Label Grid.Row="1" Text="{Binding Mensaje}" AutomationId="RutaMensaje"
               SemanticProperties.Description="{Binding Mensaje}" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Envios}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No hay envios en la ruta." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Envio">
                    <Border Padding="16" Margin="0,6">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding NumeroSeguimiento}" FontAttributes="Bold" FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Text="{Binding Destinatario}" />
                            <Label Text="{Binding Direccion}" />
                            <Label Text="{Binding EstadoServidorTexto}" Style="{StaticResource EnvioStatusLabel}" />
                            <Label Text="{Binding EstadoLocalTexto}" FontAttributes="Bold" />
                            <Label Text="{Binding ComprobanteTexto}" Style="{StaticResource MutedLabel}" />
                            <Button Text="Escanear carga" IsEnabled="{Binding PuedeCargar}" Clicked="EscanearCarga" CommandParameter="{Binding .}" />
                            <Button Text="Registrar entrega" IsEnabled="{Binding PuedeEntregar}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RutaViewModel}}, Path=SeleccionarEntregaCommand}"
                                    CommandParameter="{Binding .}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Text="Sincronizar" Command="{Binding SincronizarCommand}"
                    AutomationId="RutaSincronizar" />
            <Button Grid.Column="1" Text="Cerrar sesion" Command="{Binding CerrarSesionCommand}" Style="{StaticResource SecondaryButton}" />
        </Grid>
      </Grid>
        <Grid IsVisible="{Binding HaySeleccion}"
              BackgroundColor="{AppThemeBinding Light={StaticResource AppBackground}, Dark={StaticResource AppBackgroundDark}}" Padding="8">
            <ScrollView>
              <Border Padding="20" VerticalOptions="Start">
                <VerticalStackLayout Spacing="12">
                    <Label Text="COMPROBANTE DE ENTREGA" Style="{StaticResource SectionLabel}" />
                    <Label Text="Registrar entrega" Style="{StaticResource HeadingLabel}" FontSize="22" />
                    <Label Text="{Binding EnvioSeleccionado.NumeroSeguimiento}" Style="{StaticResource SectionLabel}" />
                    <Label Text="Nombre de quien recibe" FontAttributes="Bold" />
                    <Entry Text="{Binding NombreReceptor}" MaxLength="100"
                           Placeholder="Receptor de prueba" AutomationId="EntregaReceptor" />
                    <Label Text="Observaciones opcionales" FontAttributes="Bold" />
                    <Editor Text="{Binding Observaciones}" MaxLength="500" HeightRequest="90"
                            AutomationId="EntregaObservaciones" />
                    <HorizontalStackLayout>
                        <Label Text="Intento fallido (motivo obligatorio)" />
                        <Switch IsToggled="{Binding IntentoFallido}" />
                    </HorizontalStackLayout>
                    <Button Text="Tomar foto JPEG" Clicked="TomarFoto" />
                    <Button Text="Capturar posicion GPS" Clicked="CapturarGps" />
                    <Label Text="Firma: dibuja en el recuadro. Se registra hora con offset al guardar." />
                    <GraphicsView x:Name="LienzoFirma" HeightRequest="180" BackgroundColor="White"
                                  StartInteraction="IniciarFirma" DragInteraction="DibujarFirma" />
                    <Button Text="Borrar firma" Clicked="BorrarFirma" />
                    <Label x:Name="EstadoEvidencia" />
                    <Label Text="{Binding Mensaje}" AutomationId="EntregaMensaje" />
                    <Button Text="Guardar entrega / intento pendiente" Clicked="GuardarEvidencia"
                            AutomationId="EntregaGuardar" />
                    <Button Text="Cancelar" Command="{Binding CancelarEntregaCommand}" Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
              </Border>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
