<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Plataforma.Mobile.ViewModels"
             xmlns:models="clr-namespace:Plataforma.Mobile.Models"
             x:Class="Plataforma.Mobile.Pages.RutaPage"
             x:DataType="vm:RutaViewModel"
             HideSoftInputOnTapped="True"
             SafeAreaEdges="All"
             Title="Ruta del dia">
    <Grid Padding="16,8">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" IsVisible="{Binding MostrarRuta}">
        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="MI JORNADA" Style="{StaticResource SectionLabel}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Cerrar sesion" Command="{Binding CerrarSesionCommand}"
                        Style="{StaticResource SecondaryButton}" FontSize="12" />
            </Grid>
            <Label Text="{Binding Titulo}" Style="{StaticResource HeadingLabel}" FontSize="22" />
            <Label Text="{Binding Resumen}" AutomationId="RutaResumen" FontAttributes="Bold" />
            <Label Text="Tus comprobantes se guardan en el dispositivo y se sincronizan al recuperar Internet."
                   Style="{StaticResource MutedLabel}" />
        </VerticalStackLayout>
        <Label Grid.Row="1" Text="{Binding Mensaje}" AutomationId="RutaMensaje"
               SemanticProperties.Description="{Binding Mensaje}">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding Mensaje}" Value="">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Label.Triggers>
        </Label>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Envios}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Border Padding="24" Margin="0,8">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Tu ruta esta vacia" Style="{StaticResource HeadingLabel}" FontSize="20" />
                        <Label Text="Pulsa Actualizar ruta para consultar tus envios asignados."
                               Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.Footer>
                <VerticalStackLayout Spacing="12" Padding="0,12">
                    <Button Text="Opciones de sincronizacion y dispositivo"
                            Command="{Binding AlternarOpcionesCommand}" Style="{StaticResource SecondaryButton}" />
                    <Border Padding="16" IsVisible="{Binding MostrarOpciones}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="SINCRONIZACION" Style="{StaticResource SectionLabel}" />
                            <Label Text="Los rechazos requieren revision. El reintento conserva el comprobante original."
                                   Style="{StaticResource MutedLabel}" />
                            <Button Text="Reintentar rechazados" Command="{Binding ReintentarRechazadosCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                            <Label Text="DISPOSITIVO" Style="{StaticResource SectionLabel}" />
                            <Label Text="Registro manual de token. No activa notificaciones push."
                                   Style="{StaticResource MutedLabel}" />
                            <Entry Placeholder="Token del dispositivo" Text="{Binding TokenDispositivo}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="Registrar" Command="{Binding AltaDispositivoCommand}" />
                                <Button Grid.Column="1" Text="Eliminar" Command="{Binding BajaDispositivoCommand}"
                                        Style="{StaticResource SecondaryButton}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Envio">
                    <Border Padding="16" Margin="0,6">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding NumeroSeguimiento}" FontAttributes="Bold" FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Text="{Binding Destinatario}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Direccion}" Style="{StaticResource MutedLabel}" FontSize="14" />
                            <Label Text="{Binding EstadoServidorTexto}" Style="{StaticResource EnvioStatusLabel}" />
                            <Label Text="{Binding EstadoLocalTexto}" FontAttributes="Bold" />
                            <Label Text="{Binding ComprobanteTexto}" Style="{StaticResource MutedLabel}" />
                            <Button Text="Escanear carga" IsVisible="{Binding PuedeCargar}" IsEnabled="{Binding PuedeCargar}"
                                    Clicked="EscanearCarga" CommandParameter="{Binding .}" />
                            <Button Text="Registrar entrega" IsVisible="{Binding PuedeEntregar}" IsEnabled="{Binding PuedeEntregar}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RutaViewModel}}, Path=SeleccionarEntregaCommand}"
                                    CommandParameter="{Binding .}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" HeightRequest="24" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="Actualizar ruta" Command="{Binding DescargarRutaCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Grid.Column="1" Text="Sincronizar" Command="{Binding SincronizarCommand}" />
            </Grid>
        </VerticalStackLayout>
      </Grid>
        <Grid IsVisible="{Binding HaySeleccion}"
              BackgroundColor="{AppThemeBinding Light={StaticResource AppBackground}, Dark={StaticResource AppBackgroundDark}}">
            <ScrollView>
              <Border Padding="20" VerticalOptions="Start">
                <VerticalStackLayout Spacing="12">
                    <Label Text="COMPROBANTE DE ENTREGA" Style="{StaticResource SectionLabel}" />
                    <Label Text="Registrar entrega" Style="{StaticResource HeadingLabel}" FontSize="22" />
                    <Label Text="{Binding EnvioSeleccionado.NumeroSeguimiento}" Style="{StaticResource SectionLabel}" />
                    <Label Text="Nombre de quien recibe" FontAttributes="Bold" />
                    <Entry Text="{Binding NombreReceptor}" MaxLength="100"
                           Placeholder="Nombre del receptor" AutomationId="EntregaReceptor" />
                    <Label Text="Observaciones / motivo del intento fallido" FontAttributes="Bold" />
                    <Editor Text="{Binding Observaciones}" MaxLength="500" HeightRequest="90"
                            AutomationId="EntregaObservaciones" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="Intento fallido" VerticalOptions="Center" FontAttributes="Bold" />
                        <Switch Grid.Column="1" IsToggled="{Binding IntentoFallido}" />
                    </Grid>
                    <Label Text="EVIDENCIA OPCIONAL" Style="{StaticResource SectionLabel}" />
                    <Button Text="Tomar foto" Clicked="TomarFoto" Style="{StaticResource SecondaryButton}" />
                    <Image x:Name="VistaPreviaFoto" IsVisible="False" HeightRequest="220"
                           Aspect="AspectFit" SemanticProperties.Description="Foto adjunta al comprobante" />
                    <Label Text="La ubicacion se captura automaticamente al guardar. Activa el GPS y permite el acceso a tu ubicacion."
                           Style="{StaticResource MutedLabel}" />
                    <Label Text="Firma del receptor" FontAttributes="Bold" />
                    <Label Text="Dibuja en el recuadro. La hora se registra al guardar." Style="{StaticResource MutedLabel}" />
                    <GraphicsView x:Name="LienzoFirma" HeightRequest="180" BackgroundColor="White"
                                  StartInteraction="IniciarFirma" DragInteraction="DibujarFirma" />
                    <Button Text="Borrar firma" Clicked="BorrarFirma" Style="{StaticResource SecondaryButton}" />
                    <Label x:Name="EstadoEvidencia" />
                    <Label Text="{Binding Mensaje}" AutomationId="EntregaMensaje" />
                    <Button Text="Guardar entrega / intento pendiente" Clicked="GuardarEvidencia"
                            AutomationId="EntregaGuardar" />
                    <Button Text="Cancelar" Command="{Binding CancelarEntregaCommand}" Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
              </Border>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
