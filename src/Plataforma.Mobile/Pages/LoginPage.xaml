<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Plataforma.Mobile.ViewModels"
             x:Class="Plataforma.Mobile.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             HideSoftInputOnTapped="True"
             SafeAreaEdges="All"
             Title="Acceso de repartidor">
    <Grid Padding="24">
        <ScrollView>
            <VerticalStackLayout Spacing="16" MaximumWidthRequest="500" HorizontalOptions="Fill">
                <Label Text="ULTIMA MILLA / REPARTIDOR" Style="{StaticResource SectionLabel}" HorizontalTextAlignment="Center" />
                <Label Text="Ingresa a tu cuenta" Style="{StaticResource HeadingLabel}" HorizontalTextAlignment="Center" />
                <Label Text="Consulta tu ruta y registra entregas sin conexion." Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                <Border Padding="20">
                  <VerticalStackLayout Spacing="12">
                <Label Text="{Binding ModoTexto}" Style="{StaticResource MutedLabel}" />
                <HorizontalStackLayout Spacing="10">
                    <Label Text="Usar demo (sin API)" VerticalOptions="Center" />
                    <Switch IsToggled="{Binding ModoDemo}" AutomationId="ModoDemo" />
                </HorizontalStackLayout>
                <Label Text="Usuario" FontAttributes="Bold" />
                <Entry x:Name="UsuarioEntry" Text="{Binding Usuario}" Placeholder="alvaro@demo.test"
                       AutomationId="LoginUsuario" />
                <Label Text="Clave" FontAttributes="Bold" />
                <Entry x:Name="ClaveEntry" Text="{Binding Clave}" IsPassword="True" Placeholder="Clave"
                       ReturnType="Go" ReturnCommand="{Binding IngresarCommand}"
                       AutomationId="LoginClave" />
                <Label Text="Acceso al doble: alvaro@demo.test / Demo123!" IsVisible="{Binding ModoDemo}" Style="{StaticResource MutedLabel}" />
                <Button Text="Ingresar" Command="{Binding IngresarCommand}"
                        AutomationId="LoginIngresar" />
                <Button Text="Continuar sesion guardada (sin red)"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ContinuarSesionCommand}" AutomationId="LoginContinuar" />
                <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" />
                <Label Text="{Binding Mensaje}" AutomationId="LoginMensaje"
                       SemanticProperties.Description="{Binding Mensaje}" />
                  </VerticalStackLayout>
                </Border>
                <Label Text="Ruta y cola en SQLite sin cifrar. Usa solo datos ficticios del laboratorio. El token de API se guarda en almacenamiento seguro." Style="{StaticResource MutedLabel}" />
                <Label Text="Contrato JSON aceptado en contracts/repartidor (v1)." Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
