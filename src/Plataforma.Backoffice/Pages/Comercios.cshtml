@page
@model ComerciosModel
@{
    ViewData["Title"] = "Comercios";
    var editando = Model.Editar is not null;
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
        <p class="text-uppercase fw-semibold small mb-1" style="color: @Model.ColorMarcaCss">Administración</p>
        <h1 class="display-6 fw-bold mb-1">Comercios</h1>
        <p class="text-muted mb-0">Clientes de <strong>@Model.Operador?.Nombre</strong>.</p>
    </div>
    <form method="post" action="/logout">
        <button class="btn btn-outline-secondary" type="submit">Cerrar sesión</button>
    </form>
</div>

@if (Model.Mensaje is not null)
{
    <div class="alert alert-success" role="status">@Model.Mensaje</div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">@(editando ? "Modificar comercio" : "Nuevo comercio")</h2>
    </div>
    <div class="card-body p-4">
        <form method="post" asp-page-handler="Guardar" asp-route-editar="@Model.Editar">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold" asp-for="Formulario.NombreComercial">Nombre comercial</label>
                    <input class="form-control" asp-for="Formulario.NombreComercial" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold" asp-for="Formulario.RazonSocial">Razón social</label>
                    <input class="form-control" asp-for="Formulario.RazonSocial" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold" asp-for="Formulario.DocumentoFiscal">Documento fiscal</label>
                    <input class="form-control" asp-for="Formulario.DocumentoFiscal" />
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-semibold" asp-for="Formulario.DireccionPrincipal">Dirección principal</label>
                    <input class="form-control" asp-for="Formulario.DireccionPrincipal" />
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">@(editando ? "Guardar cambios" : "Crear comercio")</button>
                @if (editando)
                {
                    <a class="btn btn-outline-secondary" asp-page="/Comercios" asp-route-editar="">Cancelar</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Comercios registrados</h2>
        <span class="badge rounded-pill text-bg-light">@Model.Comercios.Count</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Comercio</th>
                        <th>Razón social</th>
                        <th>Documento</th>
                        <th>Dirección</th>
                        <th>Estado</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Comercios.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">Todavía no hay comercios.</td>
                    </tr>
                }
                @foreach (var comercio in Model.Comercios)
                {
                    <tr>
                        <td class="fw-semibold">@comercio.NombreComercial</td>
                        <td>@comercio.RazonSocial</td>
                        <td>@comercio.DocumentoFiscal</td>
                        <td>@comercio.DireccionPrincipal</td>
                        <td>
                            @if (comercio.Activo)
                            {
                                <span class="status-badge status-entregado">Activo</span>
                            }
                            else
                            {
                                <span class="status-badge status-extraviado">Dado de baja</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a class="btn btn-sm btn-outline-secondary" asp-page="/Comercios" asp-route-editar="@comercio.Id">Editar</a>
                                <form method="post" asp-page-handler="CambiarActivo">
                                    <input type="hidden" name="comercioId" value="@comercio.Id" />
                                    <input type="hidden" name="activo" value="@(comercio.Activo ? "false" : "true")" />
                                    <button class="btn btn-sm @(comercio.Activo ? "btn-outline-danger" : "btn-outline-primary")" type="submit">
                                        @(comercio.Activo ? "Dar de baja" : "Reactivar")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
