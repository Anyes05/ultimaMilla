@page
@model ReportesModel
@using Plataforma.Application
@{
    ViewData["Title"] = "Reportes";
    var datos = Model.Datos;
}

<div class="mb-4">
    <p class="text-uppercase fw-semibold small mb-1" style="color: @EstadosVista.ColorMarca(Model.Operador)">Administración</p>
    <h1 class="display-6 fw-bold mb-1">Reportes de gestión</h1>
    <p class="text-muted mb-0">Cumplimiento, motivos de no entrega, volumen y liquidación de <strong>@Model.Operador?.Nombre</strong>.</p>
</div>

@if (Model.Mensaje is not null)
{
    <div class="alert alert-success" role="status">@Model.Mensaje</div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

<form method="get" class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4 row g-3 align-items-end">
        <div class="col-sm-3">
            <label class="form-label fw-semibold" for="desde">Desde</label>
            <input id="desde" name="Desde" type="date" class="form-control" value="@Model.Desde?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-sm-3">
            <label class="form-label fw-semibold" for="hasta">Hasta</label>
            <input id="hasta" name="Hasta" type="date" class="form-control" value="@Model.Hasta?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-sm-4">
            <label class="form-label fw-semibold" for="comercio">Comercio</label>
            <select id="comercio" name="ComercioId" class="form-select">
                <option value="">Todos</option>
                @foreach (var comercio in Model.Comercios)
                {
                    <option value="@comercio.Id" selected="@(comercio.Id == Model.ComercioId)">@comercio.NombreComercial</option>
                }
            </select>
        </div>
        <div class="col-sm-2">
            <button class="btn btn-primary w-100" type="submit">Ver</button>
        </div>
    </div>
</form>

@if (datos is not null)
{
    <p class="small text-muted">Envíos creados entre el @datos.Desde.ToString("dd/MM/yyyy") y el @datos.Hasta.ToString("dd/MM/yyyy"), en la hora del operador.
        "A tiempo" compara la primera entrega con el plazo de la regla operativa vigente al alta.</p>

    <div class="row g-3 mb-4">
        @foreach (var (titulo, valor) in new[]
        {
            ("Envíos", datos.Envios.ToString()),
            ("Entregados", datos.Entregados.ToString()),
            ("Devueltos", datos.Devueltos.ToString()),
            ("En curso", datos.EnCurso.ToString()),
            ("Entrega efectiva", ReportesModel.Porcentaje(datos.Total.PorcentajeEntrega)),
            ("A tiempo", ReportesModel.Porcentaje(datos.Total.PorcentajeATiempo)),
            ("Facturado (entregados)", ReportesModel.Importe(datos.MontoEntregado))
        })
        {
            <div class="col-6 col-md-3 col-xl">
                <div class="card border-0 shadow-sm h-100"><div class="card-body p-3">
                    <span class="small text-muted d-block">@titulo</span>
                    <strong class="fs-4" data-indicador="@titulo">@valor</strong>
                </div></div>
            </div>
        }
    </div>

    <div class="row g-4 mb-4">
        @foreach (var (titulo, filas) in new[] { ("Cumplimiento por zona", datos.PorZona), ("Cumplimiento por repartidor", datos.PorRepartidor), ("Cumplimiento por comercio", datos.PorComercio) })
        {
            <div class="col-xl-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white"><h2 class="h6 mb-0">@titulo</h2></div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0" data-reporte="@titulo">
                            <thead class="table-light"><tr><th></th><th class="text-end">Envíos</th><th class="text-end">Entrega</th><th class="text-end">A tiempo</th></tr></thead>
                            <tbody>
                            @if (filas.Count == 0)
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">Sin envíos en el período.</td></tr>
                            }
                            @foreach (var fila in filas)
                            {
                                <tr>
                                    <td>@fila.Nombre</td>
                                    <td class="text-end">@fila.Envios</td>
                                    <td class="text-end">@ReportesModel.Porcentaje(fila.PorcentajeEntrega)</td>
                                    <td class="text-end">@ReportesModel.Porcentaje(fila.PorcentajeATiempo)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><h2 class="h6 mb-0">Motivos de no entrega</h2></div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0" data-reporte="motivos">
                        <thead class="table-light"><tr><th>Motivo</th><th class="text-end">Intentos</th></tr></thead>
                        <tbody>
                        @if (datos.MotivosNoEntrega.Count == 0)
                        {
                            <tr><td colspan="2" class="text-center text-muted py-3">No hubo intentos fallidos.</td></tr>
                        }
                        @foreach (var motivo in datos.MotivosNoEntrega)
                        {
                            <tr><td>@motivo.Motivo</td><td class="text-end">@motivo.Cantidad</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><h2 class="h6 mb-0">Volumen por día</h2></div>
                <div class="table-responsive" style="max-height: 320px">
                    <table class="table table-sm align-middle mb-0" data-reporte="volumen">
                        <thead class="table-light"><tr><th>Día</th><th class="text-end">Envíos</th><th class="text-end">Tarifas</th></tr></thead>
                        <tbody>
                        @if (datos.Volumen.Count == 0)
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">Sin envíos en el período.</td></tr>
                        }
                        @foreach (var dia in datos.Volumen)
                        {
                            <tr><td>@dia.Dia.ToString("dd/MM/yyyy")</td><td class="text-end">@dia.Envios</td><td class="text-end">@ReportesModel.Importe(dia.Monto)</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white"><h2 class="h6 mb-0">Retiros en domicilio del período</h2></div>
        <div class="card-body small" data-reporte="retiros">
            Solicitados <strong>@datos.Retiros.Solicitados</strong> ·
            Programados <strong>@datos.Retiros.Programados</strong> ·
            En curso <strong>@datos.Retiros.EnCurso</strong> ·
            Completados <strong>@datos.Retiros.Completados</strong> ·
            Cancelados <strong>@datos.Retiros.Cancelados</strong>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white"><h2 class="h6 mb-0">Liquidación por comercio del período</h2></div>
        <div class="table-responsive">
            <table class="table align-middle mb-0" data-reporte="liquidacion">
                <thead class="table-light"><tr><th>Comercio</th><th class="text-end">Entregados</th><th class="text-end">A liquidar</th><th></th></tr></thead>
                <tbody>
                @if (datos.Liquidacion.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-3">No hay envíos entregados en el período.</td></tr>
                }
                @foreach (var fila in datos.Liquidacion)
                {
                    <tr>
                        <td class="fw-semibold">@fila.Comercio</td>
                        <td class="text-end">@fila.Entregados</td>
                        <td class="text-end">@ReportesModel.Importe(fila.Monto)</td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Abrir" asp-route-desde="@Model.Desde?.ToString("yyyy-MM-dd")" asp-route-hasta="@Model.Hasta?.ToString("yyyy-MM-dd")" asp-route-comercioId="@Model.ComercioId">
                                <input type="hidden" name="comercioLiquidar" value="@fila.ComercioId" />
                                <button class="btn btn-sm btn-outline-primary" type="submit">Abrir liquidación</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0">Liquidaciones</h2>
        <span class="badge rounded-pill text-bg-light">@Model.Liquidaciones.Count</span>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0" data-reporte="liquidaciones">
            <thead class="table-light"><tr><th>Comercio</th><th>Período</th><th class="text-end">Monto</th><th>Estado</th><th></th></tr></thead>
            <tbody>
            @if (Model.Liquidaciones.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-3">Todavía no hay liquidaciones.</td></tr>
            }
            @foreach (var liquidacion in Model.Liquidaciones)
            {
                <tr>
                    <td class="fw-semibold">@Model.NombreComercio(liquidacion.ComercioId)</td>
                    <td>@Model.FechaLocal(liquidacion.PeriodoDesde) al @Model.FechaLocal(liquidacion.PeriodoHasta)</td>
                    <td class="text-end">@ReportesModel.Importe(liquidacion.Monto)</td>
                    <td><span class="status-badge @(liquidacion.Cerrada ? "status-entregado" : "status-en-transito")">@(liquidacion.Cerrada ? "Cerrada" : "Abierta")</span></td>
                    <td class="text-end">
                        @if (!liquidacion.Cerrada)
                        {
                            <form method="post" asp-page-handler="Cerrar" asp-route-desde="@Model.Desde?.ToString("yyyy-MM-dd")" asp-route-hasta="@Model.Hasta?.ToString("yyyy-MM-dd")" asp-route-comercioId="@Model.ComercioId">
                                <input type="hidden" name="liquidacionId" value="@liquidacion.Id" />
                                <button class="btn btn-sm btn-outline-secondary" type="submit">Cerrar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
