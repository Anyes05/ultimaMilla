@page
@model UsuariosModel
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
        <p class="text-uppercase fw-semibold small mb-1" style="color: @Model.ColorMarcaCss">Administración</p>
        <h1 class="display-6 fw-bold mb-1">Usuarios</h1>
        <p class="text-muted mb-0">ABM de usuarios del operador <strong>@Model.Operador?.Nombre</strong>.</p>
    </div>
    <form method="post" action="/logout">
        <button class="btn btn-outline-secondary" type="submit">Cerrar sesión</button>
    </form>
</div>

@if (Model.Mensaje is not null)
{
    <div class="alert alert-success" role="status">@Model.Mensaje</div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">Alta</h2>
    </div>
    <div class="card-body p-4">
        <form method="post" asp-page-handler="Registrar">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Nuevo.Nombre" class="form-label"></label>
                    <input asp-for="Nuevo.Nombre" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Nuevo.Email" class="form-label"></label>
                    <input asp-for="Nuevo.Email" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Nuevo.NombreUsuario" class="form-label"></label>
                    <input asp-for="Nuevo.NombreUsuario" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Nuevo.Clave" class="form-label"></label>
                    <input asp-for="Nuevo.Clave" class="form-control" type="password" autocomplete="new-password" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Nuevo.Rol" class="form-label"></label>
                    <select asp-for="Nuevo.Rol" class="form-select" asp-items="Model.RolesDisponibles"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Nuevo.ComercioId" class="form-label">Comercio (solo rol Comercio)</label>
                    <input asp-for="Nuevo.ComercioId" class="form-control" />
                </div>
            </div>
            <button class="btn btn-primary mt-3" type="submit">Registrar usuario</button>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">Listado</h2>
    </div>
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead>
            <tr>
                <th>Usuario</th>
                <th>Nombre</th>
                <th>Rol</th>
                <th>Estado</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var u in Model.Lista)
            {
                <tr>
                    <td>@u.NombreUsuario</td>
                    <td>@u.Nombre</td>
                    <td>@u.Rol</td>
                    <td>@(u.Activo ? "Activo" : "Inactivo")</td>
                    <td class="text-end">
                        <form method="post" asp-page-handler="Toggle" class="d-inline">
                            <input type="hidden" name="id" value="@u.Id" />
                            <input type="hidden" name="activo" value="@(!u.Activo)" />
                            <button class="btn btn-sm btn-outline-secondary" type="submit">
                                @(u.Activo ? "Desactivar" : "Activar")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
