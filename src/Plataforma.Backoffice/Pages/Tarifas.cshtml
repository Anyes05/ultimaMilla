@page
@model TarifasModel
@{
    ViewData["Title"] = "Tarifas";
    var vigente = Model.Vigente;
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
        <p class="text-uppercase fw-semibold small mb-1" style="color: @Model.ColorMarcaCss">Administración</p>
        <h1 class="display-6 fw-bold mb-1">Cuadro tarifario</h1>
        <p class="text-muted mb-0">Tarifa que se aplica al dar de alta un envío de <strong>@Model.Operador?.Nombre</strong>.</p>
    </div>
    <form method="post" action="/logout">
        <button class="btn btn-outline-secondary" type="submit">Cerrar sesión</button>
    </form>
</div>

@if (Model.Mensaje is not null)
{
    <div class="alert alert-success" role="status">@Model.Mensaje</div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Tarifa vigente</h2>
        @if (vigente is not null)
        {
            <span class="status-badge status-en-transito">Vigente</span>
        }
    </div>
    <div class="card-body p-4">
        @if (vigente is null)
        {
            <p class="text-muted mb-0">El operador no tiene una tarifa vigente: el alta de envíos va a fallar hasta que se publique una.</p>
        }
        else
        {
            @* 4 por fila en pantallas grandes, 3 en medianas y 2 en celular: cada importe en una sola línea. *@
            <div class="row g-3">
                @foreach (var (titulo, valor, atributo) in new (string, string, string?)[]
                {
                    ("Precio base", TarifasModel.Importe(vigente.PrecioBase), null),
                    ("Por kg", TarifasModel.Importe(vigente.PrecioPorKg), null),
                    ("Por km", TarifasModel.Importe(vigente.PrecioPorKm), null),
                    ("Por cm³", TarifasModel.Importe(vigente.PrecioPorCm3), null),
                    ("Recargo frágil", "+" + TarifasModel.Importe(vigente.RecargoFragil), null),
                    ("Recargo urgente", "+" + TarifasModel.Importe(vigente.RecargoUrgente), null),
                    ("Recargo zona", "+" + TarifasModel.Importe(vigente.RecargoZona), null),
                    ("Por retiro", TarifasModel.Importe(vigente.PrecioRetiro), "retiro"),
                })
                {
                    <div class="col-6 col-md-4 col-xl-3" data-vigente-retiro="@(atributo == "retiro" ? "" : null)">
                        <div class="border rounded-3 bg-light p-3 h-100">
                            <span class="small text-muted d-block">@titulo</span>
                            <strong class="fs-5 text-nowrap">@valor</strong>
                        </div>
                    </div>
                }
            </div>
            @if (Model.VersionVigente?.Valores is { } valores)
            {
                <div class="row g-3 mt-1 small">
                    <div class="col-md-6" data-vigente-zonas><strong class="d-block">Recargo por zona</strong>@Model.DescribirZonas(valores)</div>
                    <div class="col-md-6" data-vigente-bonificaciones><strong class="d-block">Bonificaciones</strong>@Model.DescribirBonificaciones(valores)</div>
                </div>
            }
        }
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">Probar tarifa</h2>
    </div>
    <div class="card-body p-4">
        <form method="post" asp-page-handler="Simular">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3 align-items-end">
                <div class="col-12 col-sm-4">
                    <label class="form-label fw-semibold" asp-for="Simulacion.PesoKg">Peso (kg)</label>
                    <input class="form-control" asp-for="Simulacion.PesoKg" type="number" step="0.1" min="0" />
                    <span class="text-danger small" asp-validation-for="Simulacion.PesoKg"></span>
                </div>
                <div class="col-12 col-sm-4">
                    <label class="form-label fw-semibold" asp-for="Simulacion.DistanciaKm">Distancia (km)</label>
                    <input class="form-control" asp-for="Simulacion.DistanciaKm" type="number" step="0.1" min="0" />
                    <span class="text-danger small" asp-validation-for="Simulacion.DistanciaKm"></span>
                </div>
                <div class="col-12 col-sm-4">
                    <label class="form-label fw-semibold" asp-for="Simulacion.VolumenCm3">Volumen (cm³)</label>
                    <input class="form-control" asp-for="Simulacion.VolumenCm3" type="number" step="any" min="0" />
                    <span class="text-danger small" asp-validation-for="Simulacion.VolumenCm3"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label class="form-label fw-semibold" asp-for="Simulacion.ZonaId">Zona</label>
                    <select class="form-select" asp-for="Simulacion.ZonaId">
                        <option value="">Sin zona</option>
                        @foreach (var zona in Model.Zonas)
                        {
                            <option value="@zona.Id">@zona.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-sm-6">
                    <label class="form-label fw-semibold" asp-for="Simulacion.ComercioId">Comercio</label>
                    <select class="form-select" asp-for="Simulacion.ComercioId">
                        <option value="">Cualquiera</option>
                        @foreach (var comercio in Model.Comercios)
                        {
                            <option value="@comercio.Id">@comercio.NombreComercial</option>
                        }
                    </select>
                </div>
                <div class="col-12 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="d-flex flex-wrap gap-3">
                        <div class="form-check mb-0">
                            <input class="form-check-input" asp-for="Simulacion.Urgente" />
                            <label class="form-check-label" asp-for="Simulacion.Urgente">Urgente</label>
                        </div>
                        <div class="form-check mb-0">
                            <input class="form-check-input" asp-for="Simulacion.Fragil" />
                            <label class="form-check-label" asp-for="Simulacion.Fragil">Frágil</label>
                        </div>
                        <div class="form-check mb-0">
                            <input class="form-check-input" asp-for="Simulacion.ConZona" />
                            <label class="form-check-label" asp-for="Simulacion.ConZona">Zona sin recargo propio</label>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary px-4 col-12 col-sm-auto" disabled="@(vigente is null)">Calcular</button>
                </div>
            </div>
        </form>
        @if (Model.ImporteSimulado is decimal importe)
        {
            <div class="alert alert-info mt-3 mb-0" role="status">
                Un envío con estos datos se cobraría <strong>@TarifasModel.Importe(importe)</strong> con la tarifa vigente.
                @if (Model.Detalle is { } detalle)
                {
                    @if (detalle.RecargoZona > 0)
                    {
                        <span class="d-block small" data-simulacion-zona>Incluye recargo de zona de @TarifasModel.Importe(detalle.RecargoZona).</span>
                    }
                    @if (detalle.Bonificacion is not null)
                    {
                        <span class="d-block small" data-simulacion-bonificacion>Bonificación "@detalle.Bonificacion": −@TarifasModel.Importe(detalle.Descuento).</span>
                    }
                }
            </div>
        }
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">Nueva versión</h2>
    </div>
    <div class="card-body p-4">
        <p class="small text-muted">
            Publicar no modifica la tarifa de envíos ya dados de alta: crea una versión nueva
            y cierra la vigencia anterior.
        </p>
        <form method="post" asp-page-handler="Publicar">
            <div class="row g-3">
                <div class="col-6 col-md-4 col-xl-3">
                    <label class="form-label fw-semibold" asp-for="NuevaVersion.PrecioBase">Precio base</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input class="form-control" asp-for="NuevaVersion.PrecioBase" type="number" step="0.01" min="0" />
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-3">
                    <label class="form-label fw-semibold" asp-for="NuevaVersion.PrecioPorKg">Por kg</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input class="form-control" asp-for="NuevaVersion.PrecioPorKg" type="number" step="0.01" min="0" />
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-3">
                    <label class="form-label fw-semibold" asp-for="NuevaVersion.PrecioPorKm">Por km</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input class="form-control" asp-for="NuevaVersion.PrecioPorKm" type="number" step="0.01" min="0" />
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-3">
                    <label class="form-label fw-semibold" asp-for="NuevaVersion.RecargoFragil">Recargo frágil</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input class="form-control" asp-for="NuevaVersion.RecargoFragil" type="number" step="0.01" min="0" />
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-3">
                    <label class="form-label fw-semibold" asp-for="NuevaVersion.RecargoUrgente">Recargo urgente</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input class="form-control" asp-for="NuevaVersion.RecargoUrgente" type="number" step="0.01" min="0" />
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-3">
                    <label class="form-label fw-semibold" asp-for="NuevaVersion.PrecioPorCm3">Por cm³</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input class="form-control" asp-for="NuevaVersion.PrecioPorCm3" type="number" step="any" min="0" />
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-3">
                    <label class="form-label fw-semibold" asp-for="NuevaVersion.RecargoZona">Recargo zona</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input class="form-control" asp-for="NuevaVersion.RecargoZona" type="number" step="0.01" min="0" />
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-3">
                    <label class="form-label fw-semibold" asp-for="NuevaVersion.PrecioRetiro">Por retiro</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input class="form-control" asp-for="NuevaVersion.PrecioRetiro" type="number" step="0.01" min="0" />
                    </div>
                </div>
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>
            <h3 class="h6 mt-4">Recargo por zona</h3>
            @if (Model.NuevaVersion.Zonas.Count == 0)
            {
                <p class="small text-muted">No hay zonas cargadas. Se crean en Zonas, franjas y vehículos.</p>
            }
            else
            {
                <p class="small text-muted">Vacío: la zona usa el recargo general de zona.</p>
                <div class="row g-2">
                    @for (var i = 0; i < Model.NuevaVersion.Zonas.Count; i++)
                    {
                        <div class="col-sm-6 col-lg-3">
                            <input type="hidden" asp-for="NuevaVersion.Zonas[i].ZonaId" />
                            <label class="form-label small fw-semibold" asp-for="NuevaVersion.Zonas[i].Recargo">@Model.NombreZona(Model.NuevaVersion.Zonas[i].ZonaId)</label>
                            <input class="form-control" asp-for="NuevaVersion.Zonas[i].Recargo" type="number" step="0.01" min="0" />
                        </div>
                    }
                </div>
            }
            <h3 class="h6 mt-4">Bonificaciones</h3>
            <p class="small text-muted">Si un envío cumple varias, se aplica la de mayor porcentaje. "Desde el envío N del mes" cuenta los envíos del comercio en el mes.</p>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Nombre</th><th>Porcentaje</th><th>Comercio</th><th>Desde el envío N del mes</th></tr></thead>
                    <tbody>
                    @for (var i = 0; i < Model.NuevaVersion.Bonificaciones.Count; i++)
                    {
                        <tr>
                            <td><input class="form-control form-control-sm" asp-for="NuevaVersion.Bonificaciones[i].Nombre" placeholder="Ej.: Cliente mayorista" /></td>
                            <td><input class="form-control form-control-sm" asp-for="NuevaVersion.Bonificaciones[i].Porcentaje" type="number" step="0.01" min="0" max="100" /></td>
                            <td>
                                <select class="form-select form-select-sm" asp-for="NuevaVersion.Bonificaciones[i].ComercioId">
                                    <option value="">Todos</option>
                                    @foreach (var comercio in Model.Comercios)
                                    {
                                        <option value="@comercio.Id">@comercio.NombreComercial</option>
                                    }
                                </select>
                            </td>
                            <td><input class="form-control form-control-sm" asp-for="NuevaVersion.Bonificaciones[i].MinimoEnviosMes" type="number" min="1" /></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-end gap-3 mt-3 flex-wrap">
                <div>
                    <label class="form-label fw-semibold" asp-for="NuevaVersion.VigenteDesdeLocal">Vigente desde</label>
                    <input class="form-control" asp-for="NuevaVersion.VigenteDesdeLocal" type="datetime-local" />
                </div>
                <button type="submit" class="btn btn-primary">Publicar nueva versión</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">Historial de versiones</h2>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Desde</th>
                        <th>Hasta</th>
                        <th>Base</th>
                        <th>Por kg</th>
                        <th>Por km</th>
                        <th>Por cm³</th>
                        <th>Recargo zona</th>
                        <th>Por retiro</th>
                        <th>Por zona</th>
                        <th>Bonificaciones</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Versiones.Count == 0)
                {
                    <tr>
                        <td colspan="11" class="text-center text-muted py-5">Todavía no hay versiones publicadas.</td>
                    </tr>
                }
                else
                {
                    @foreach (var version in Model.Versiones)
                    {
                        <tr>
                            <td>@Model.HoraOperador(version.Desde)</td>
                            <td>@(version.Hasta.Year >= 9999 ? "—" : Model.HoraOperador(version.Hasta))</td>
                            <td>@TarifasModel.Importe(version.Valores.PrecioBase)</td>
                            <td>@TarifasModel.Importe(version.Valores.PrecioPorKg)</td>
                            <td>@TarifasModel.Importe(version.Valores.PrecioPorKm)</td>
                            <td>@TarifasModel.Importe(version.Valores.PrecioPorCm3)</td>
                            <td>@TarifasModel.Importe(version.Valores.RecargoZona)</td>
                            <td>@TarifasModel.Importe(version.Valores.PrecioRetiro)</td>
                            <td class="small">@Model.DescribirZonas(version.Valores)</td>
                            <td class="small">@Model.DescribirBonificaciones(version.Valores)</td>
                            <td>
                                @if (version.Vigente)
                                {
                                    <span class="status-badge status-en-transito">Vigente</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Histórica</span>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
