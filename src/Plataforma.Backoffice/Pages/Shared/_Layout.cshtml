@using Plataforma.Application
@using Plataforma.Domain
@inject IOperadorActual OperadorActual
@inject IOperadorRepositorio Operadores
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Plataforma.Backoffice</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Plataforma.Backoffice.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var usuario = Context.User;
        var operadorId = OperadorActual.OperadorId;
        var operador = operadorId is Guid id
            ? await Operadores.ObtenerAsync(id, Context.RequestAborted)
            : null;
        var colorMarca = operador?.ColorMarca switch
        {
            "azul" => "#0d6efd",
            "verde" => "#198754",
            _ => "#4f46e5"
        };
        var puedeMonitorear = usuario.IsInRole(Roles.Administrador)
            || usuario.IsInRole(Roles.Despachador)
            || usuario.IsInRole(Roles.OperarioDeposito);
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <span class="brand-mark" style="--operator-color: @colorMarca" aria-hidden="true"></span>
                    <span>Backoffice</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (puedeMonitorear)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Index">Monitoreo</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Despacho">Despacho</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Cache">Caché</a>
                            </li>
                        }
                    </ul>
                    @if (usuario.Identity?.IsAuthenticated == true)
                    {
                        <div class="operator-brand me-3">
                            @if (operador is not null)
                            {
                                <span class="operator-brand__name" style="--operator-color: @colorMarca">@operador.Nombre</span>
                            }
                            <span class="operator-brand__user">@usuario.Identity.Name</span>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Plataforma.Backoffice 
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
