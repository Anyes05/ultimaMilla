@using Plataforma.Application
@using Plataforma.Domain
@inject IOperadorActual OperadorActual
@inject IOperadorRepositorio Operadores
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Plataforma.Backoffice</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Plataforma.Backoffice.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var usuario = Context.User;
        var operadorId = OperadorActual.OperadorId;
        var operador = operadorId is Guid id
            ? await Operadores.ObtenerAsync(id, Context.RequestAborted)
            : null;
        var colorMarca = operador?.ColorMarca switch
        {
            "azul" => "#0d6efd",
            "verde" => "#198754",
            _ => "#4f46e5"
        };
        var puedeMonitorear = usuario.IsInRole(Roles.Administrador)
            || usuario.IsInRole(Roles.Despachador)
            || usuario.IsInRole(Roles.OperarioDeposito);
        var mostrarBarraLateral = usuario.Identity?.IsAuthenticated == true && puedeMonitorear;
        var paginaActual = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
        string ClaseNav(string pagina) =>
            string.Equals(paginaActual, pagina, StringComparison.OrdinalIgnoreCase)
                ? "app-sidebar__link active"
                : "app-sidebar__link";
    }

    @if (mostrarBarraLateral)
    {
        <div class="app-shell">
            <aside class="app-sidebar">
                <div class="app-sidebar__top">
                    <a class="app-sidebar__brand" asp-area="" asp-page="/Index">
                        <span class="brand-mark" style="--operator-color: @colorMarca" aria-hidden="true"></span>
                        <span>
                            <span class="d-block">Backoffice</span>
                            @if (operador is not null)
                            {
                                <small class="app-sidebar__operator">@operador.Nombre</small>
                            }
                        </span>
                    </a>
                    <input type="checkbox" id="app-sidebar-toggle" class="app-sidebar__toggle-input" />
                    <label for="app-sidebar-toggle" class="app-sidebar__toggle" aria-label="Abrir o cerrar el menú">
                        <span></span><span></span><span></span>
                    </label>

                    <nav class="app-sidebar__nav" aria-label="Navegación principal">
                        <a class="@ClaseNav("/Index")" asp-area="" asp-page="/Index">Monitoreo</a>
                        <a class="@ClaseNav("/Despacho")" asp-area="" asp-page="/Despacho">Despacho</a>
                        <a class="@ClaseNav("/Cache")" asp-area="" asp-page="/Cache">Caché</a>
                        <a class="@ClaseNav("/Avisos")" asp-area="" asp-page="/Avisos">Avisos</a>
                        @if (usuario.IsInRole(Roles.Administrador))
                        {
                            <a class="@ClaseNav("/Tarifas")" asp-area="" asp-page="/Tarifas">Tarifas</a>
                        }
                    </nav>
                </div>
                <div class="app-sidebar__user">
                    <span class="app-sidebar__user-label">Sesión</span>
                    <span class="app-sidebar__user-name">@usuario.Identity!.Name</span>
                </div>
            </aside>

            <div class="app-content">
                <div class="container-xl px-4">
                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                </div>
                <footer class="border-top footer text-muted">
                    <div class="container-xl px-4">
                        &copy; 2026 - Plataforma.Backoffice
                    </div>
                </footer>
            </div>
        </div>
    }
    else
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container">
                    <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                        <span class="brand-mark" style="--operator-color: @colorMarca" aria-hidden="true"></span>
                        <span>Backoffice</span>
                    </a>
                    @if (usuario.Identity?.IsAuthenticated == true)
                    {
                        <div class="operator-brand ms-auto">
                            @if (operador is not null)
                            {
                                <span class="operator-brand__name" style="--operator-color: @colorMarca">@operador.Nombre</span>
                            }
                            <span class="operator-brand__user">@usuario.Identity.Name</span>
                        </div>
                    }
                </div>
            </nav>
        </header>
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - Plataforma.Backoffice
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
