@page
@model DespachoModel
@{
    ViewData["Title"] = "Despacho de rutas";
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
        <p class="text-uppercase fw-semibold small mb-1" style="color: @Model.ColorMarcaCss">Backoffice</p>
        <h1 class="display-6 fw-bold mb-1">Despacho de rutas</h1>
        <p class="text-muted mb-0">Armá la ruta de <strong>@Model.Operador?.Nombre</strong>: es la hoja que descarga la app del repartidor.</p>
    </div>
    <form method="post" action="/logout">
        <button class="btn btn-outline-secondary" type="submit">Cerrar sesión</button>
    </form>
</div>

@if (Model.Mensaje is not null)
{
    <div class="alert alert-success" role="status">@Model.Mensaje</div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

@if (Model.Repartidores.Count == 0)
{
    <div class="alert alert-warning">No hay repartidores activos para este operador.</div>
}

<form method="post">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="repartidor">Repartidor</label>
                    <select id="repartidor" asp-for="RepartidorId" class="form-select form-select-lg" required>
                        <option value="">Elegí un repartidor…</option>
                        @foreach (var repartidor in Model.Repartidores)
                        {
                            <option value="@repartidor.Id">@repartidor.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="fecha">Fecha de la ruta</label>
                    <input id="fecha" asp-for="Fecha" type="date" class="form-control form-control-lg" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="vehiculo">Vehículo <span class="text-muted fw-normal">(valida paradas, peso y volumen)</span></label>
                    <select id="vehiculo" asp-for="VehiculoId" class="form-select">
                        <option value="">Sin vehículo asignado</option>
                        @foreach (var vehiculo in Model.Vehiculos)
                        {
                            <option value="@vehiculo.Id">@vehiculo.Patente@(string.IsNullOrWhiteSpace(vehiculo.Descripcion) ? "" : $" · {vehiculo.Descripcion}") (máx. @vehiculo.MaximoParadas paradas, @vehiculo.CapacidadPesoKg.ToString("0.#") kg)</option>
                        }
                    </select>
                </div>
            </div>
            <p class="small text-muted mt-3 mb-0">Una ruta lleva envíos de una sola franja; los envíos sin franja pueden ir en cualquiera.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">Envíos en depósito</h2>
            <span class="badge rounded-pill text-bg-light">@Model.EnviosEnDeposito.Count</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 3rem"></th>
                            <th>N° Tracking</th>
                            <th>Destinatario</th>
                            <th>Dirección de entrega</th>
                            <th>Franja</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.EnviosEnDeposito.Count > 0)
                    {
                        @foreach (var envio in Model.EnviosEnDeposito)
                        {
                            <tr>
                                <td>
                                    <input class="form-check-input" type="checkbox" name="EnvioIds" value="@envio.Id"
                                           id="envio-@envio.Id" aria-label="Incluir @envio.NumeroSeguimiento" />
                                </td>
                                <td><label for="envio-@envio.Id"><span class="tracking-number">@envio.NumeroSeguimiento</span></label></td>
                                <td>@envio.Destinatario</td>
                                <td>@envio.DireccionEntrega</td>
                                <td class="small">@Model.NombreFranja(envio.FranjaId)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                No hay envíos en depósito para despachar. Recibilos primero desde el Monitoreo.
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center gap-3 flex-wrap">
            <div class="form-check mb-0">
                <input class="form-check-input" asp-for="IniciarAlDespachar" id="iniciarAlDespachar" />
                <label class="form-check-label" for="iniciarAlDespachar">
                    Iniciar la ruta al despachar <span class="text-muted small">(los envíos salen en tránsito)</span>
                </label>
            </div>
            <button type="submit" class="btn btn-primary btn-lg"
                    disabled="@(Model.EnviosEnDeposito.Count == 0 || Model.Repartidores.Count == 0)">
                Despachar ruta
            </button>
        </div>
    </div>
</form>

<div class="card border-0 shadow-sm mt-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <div>
            <h2 class="h5 mb-0">Rutas de hoy</h2>
            <span class="small text-muted">Orden de visita: urgentes primero, después agrupados por zona y en el orden en que se eligieron.</span>
        </div>
        <span class="badge rounded-pill text-bg-light">@Model.RutasDeHoy.Count</span>
    </div>
    <div class="card-body p-0">
        @if (Model.RutasDeHoy.Count == 0)
        {
            <p class="text-center text-muted py-5 mb-0">Todavía no se despachó ninguna ruta para hoy.</p>
        }
        @foreach (var ruta in Model.RutasDeHoy)
        {
            <div class="border-bottom p-4">
                <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                    <div>
                        <h3 class="h6 fw-bold mb-0">@ruta.Repartidor</h3>
                        <span class="text-muted small">@ruta.Envios.Count envío(s)</span>
                    </div>
                    @if (ruta.PendientesDeSalir > 0)
                    {
                        <form method="post" asp-page-handler="IniciarRuta">
                            <input type="hidden" name="rutaId" value="@ruta.RutaId" />
                            <button type="submit" class="btn btn-success">
                                Iniciar ruta (@ruta.PendientesDeSalir)
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted small">Ruta en curso</span>
                    }
                </div>
                @if (Model.Perfiles.TryGetValue(ruta.RutaId, out var perfil))
                {
                    <p class="small mb-2 @(perfil.Problema is null ? "text-muted" : "text-danger")" data-carga-ruta="@ruta.RutaId">
                        @(perfil.Vehiculo is null ? "Sin vehículo" : $"Vehículo {perfil.Vehiculo}") ·
                        sale con @perfil.CargaInicialPesoKg.ToString("0.##") kg ·
                        carga máxima en el recorrido @perfil.PicoPesoKg.ToString("0.##") kg@(perfil.CapacidadPesoKg > 0 ? $" de {perfil.CapacidadPesoKg:0.##} kg" : "")
                        <span class="d-block">Recorrido: @string.Join(" → ", perfil.Paradas.Select(parada => $"{parada.Numero}. {(parada.EsRetiro ? "↑ " : "")}{parada.Descripcion} ({parada.CargaPesoKg:0.##} kg)"))</span>
                    </p>
                }
                <ol class="list-unstyled mb-0" data-paradas="@ruta.RutaId">
                    @{ var parada = 0; }
                    @foreach (var envio in ruta.Envios)
                    {
                        parada++;
                        <li class="d-flex flex-wrap justify-content-between align-items-center gap-2 py-1" data-parada="@parada">
                            <span><span class="badge rounded-pill text-bg-light me-2">@parada</span><span class="tracking-number">@envio.NumeroSeguimiento</span> · @envio.Destinatario@(envio.Urgente ? " · urgente" : "")</span>
                            <span class="d-flex align-items-center gap-2">
                                <span class="status-badge @EstadoClase(envio.Estado)">@EstadoNombre(envio.Estado)</span>
                                @if (envio.Estado is EstadoEnvio.AsignadoARuta or EstadoEnvio.EnTransito && Model.Repartidores.Any(otro => otro.Id != ruta.RepartidorId))
                                {
                                    @* Reasignación (RF 13 y opcional 7.3): urgente avisa por push al repartidor nuevo. *@
                                    <form method="post" asp-page-handler="Reasignar" class="d-flex align-items-center gap-1" data-reasignar="@envio.Id">
                                        <input type="hidden" name="envioId" value="@envio.Id" />
                                        <input type="hidden" name="fechaRuta" value="@Model.Fecha.ToString("yyyy-MM-dd")" />
                                        <select class="form-select form-select-sm" name="repartidorNuevoId" aria-label="Reasignar a" required>
                                            <option value="">Reasignar a…</option>
                                            @foreach (var otro in Model.Repartidores.Where(otro => otro.Id != ruta.RepartidorId))
                                            {
                                                <option value="@otro.Id">@otro.Nombre</option>
                                            }
                                        </select>
                                        <div class="form-check form-check-inline mb-0" title="Avisa al repartidor nuevo con una notificación push, aunque tenga la app cerrada">
                                            <input class="form-check-input" type="checkbox" name="urgente" value="true" id="urgente-@envio.Id" checked />
                                            <label class="form-check-label small" for="urgente-@envio.Id">Urgente</label>
                                        </div>
                                        <button class="btn btn-sm btn-outline-primary" type="submit">Reasignar</button>
                                    </form>
                                }
                            </span>
                        </li>
                    }
                </ol>
            </div>
        }
    </div>
</div>

@functions {
    private static string EstadoClase(EstadoEnvio estado) => estado switch
    {
        EstadoEnvio.EnDeposito => "status-en-deposito",
        EstadoEnvio.AsignadoARuta => "status-asignado-a-ruta",
        EstadoEnvio.EnTransito => "status-en-transito",
        EstadoEnvio.NoEntregado => "status-no-entregado",
        EstadoEnvio.EnDevolucion => "status-en-devolucion",
        _ => "status-" + estado.ToString().ToLowerInvariant()
    };

    private static string EstadoNombre(EstadoEnvio estado) => estado switch
    {
        EstadoEnvio.EnDeposito => "En depósito",
        EstadoEnvio.AsignadoARuta => "Asignado a ruta",
        EstadoEnvio.EnTransito => "En tránsito",
        EstadoEnvio.NoEntregado => "No entregado",
        EstadoEnvio.EnDevolucion => "En devolución",
        _ => estado.ToString()
    };
}
