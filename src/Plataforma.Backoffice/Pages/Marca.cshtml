@page
@model MarcaModel
@{
    ViewData["Title"] = "Marca";
    var color = MarcaModel.Css(Model.Formulario.ColorMarca);
    var contacto = string.Join(" · ", new[] { Model.Formulario.TelefonoContacto, Model.Formulario.EmailContacto }.Where(dato => !string.IsNullOrWhiteSpace(dato)));
}

<div class="mb-4">
    <p class="text-uppercase fw-semibold small mb-1" style="color: @EstadosVista.ColorMarca(Model.Operador)">Administración</p>
    <h1 class="display-6 fw-bold mb-1">Marca del operador</h1>
    <p class="text-muted mb-0">Cómo ven a <strong>@Model.Operador?.Nombre</strong> los comercios, los destinatarios y los correos.</p>
</div>

@if (Model.Mensaje is not null)
{
    <div class="alert alert-success" role="status">@Model.Mensaje</div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" asp-for="Formulario.ColorMarca">Color de la marca</label>
                        <select class="form-select" asp-for="Formulario.ColorMarca" asp-items="MarcaModel.Colores"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" asp-for="Formulario.TelefonoContacto">Teléfono de contacto</label>
                        <input class="form-control" asp-for="Formulario.TelefonoContacto" placeholder="Ej.: 2900 1234" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold" asp-for="Formulario.EmailContacto">Email de contacto</label>
                        <input class="form-control" asp-for="Formulario.EmailContacto" type="email" placeholder="consultas@operador.com" />
                    </div>
                    <button class="btn btn-primary" type="submit">Guardar</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm overflow-hidden" aria-label="Vista previa">
            <div class="p-3 text-white fw-bold" style="background: @color">@Model.Operador?.Nombre</div>
            <div class="card-body">
                <p class="small text-muted mb-1">Así se ve el encabezado del seguimiento y de los correos.</p>
                <p class="mb-0" data-vista-previa-contacto>@(contacto.Length > 0 ? $"¿Consultas? {contacto}" : "Sin datos de contacto cargados.")</p>
            </div>
        </div>
    </div>
</div>
