@page
@model TableroModel
@{
    ViewData["Title"] = "Tablero en vivo";
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
        <p class="text-uppercase fw-semibold small mb-1" style="color: @EstadosVista.ColorMarca(Model.Operador)">Backoffice</p>
        <h1 class="display-6 fw-bold mb-1">Tablero en vivo</h1>
        <p class="text-muted mb-0">Cambios de estado y avisos a comercios de <strong>@Model.Operador?.Nombre</strong>, en tiempo real.</p>
    </div>
    <span id="conexion" class="status-badge status-no-entregado" role="status">Conectando…</span>
</div>

<div class="row g-3 mb-4">
    @foreach (var (estado, cantidad) in Model.ConteoPorEstado.Where(c => c.Cantidad > 0 || c.Estado is "EnTransito" or "Entregado"))
    {
        <div class="col-6 col-md-3 col-xl-2">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <span class="small text-muted d-block">@EstadosVista.Nombre(estado)</span>
                    <strong class="fs-3" data-conteo="@estado">@cantidad</strong>
                </div>
            </div>
        </div>
    }
    <div class="col-6 col-md-3 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <span class="small text-muted d-block">Avisos recibidos por el comercio</span>
                <strong class="fs-3 text-success" id="avisos-entregados">@(Model.Avisos?.Entregados ?? 0)</strong>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <span class="small text-muted d-block">Avisos que fallaron</span>
                <strong class="fs-3 text-danger" id="avisos-fallidos">@(Model.Avisos?.Fallidos ?? 0)</strong>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h2 class="h5 mb-0">Envíos</h2></div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 520px">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>N° Tracking</th><th>Destinatario</th><th class="text-end">Estado</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var envio in Model.Envios)
                            {
                                <tr data-envio="@envio.Id" data-tracking="@envio.NumeroSeguimiento">
                                    <td><span class="tracking-number">@envio.NumeroSeguimiento</span></td>
                                    <td>@envio.Destinatario</td>
                                    <td class="text-end"><span class="status-badge @EstadosVista.Clase(envio.Estado)" data-estado="@envio.Estado">@EstadosVista.Nombre(envio.Estado)</span></td>
                                </tr>
                            }
                            @if (Model.Envios.Count == 0)
                            {
                                <tr><td colspan="3" class="text-center text-muted py-5">No hay envíos.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h2 class="h5 mb-0">Actividad</h2></div>
            <ul id="actividad" class="list-group list-group-flush" aria-live="polite">
                <li class="list-group-item text-muted small" id="actividad-vacia">Esperando eventos…</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        (() => {
            const nombres = {
                EnDeposito: "En depósito", AsignadoARuta: "Asignado a ruta", EnTransito: "En tránsito",
                NoEntregado: "No entregado", EnDevolucion: "En devolución"
            };
            const clases = {
                EnDeposito: "status-en-deposito", AsignadoARuta: "status-asignado-a-ruta", EnTransito: "status-en-transito",
                NoEntregado: "status-no-entregado", EnDevolucion: "status-en-devolucion"
            };
            const nombre = estado => nombres[estado] ?? estado;
            const clase = estado => clases[estado] ?? "status-" + estado.toLowerCase();
            const badgeConexion = document.getElementById("conexion");
            const actividad = document.getElementById("actividad");

            function estadoConexion(texto, ok) {
                badgeConexion.textContent = texto;
                badgeConexion.className = "status-badge " + (ok ? "status-entregado" : "status-no-entregado");
            }

            function registrar(texto, detalle) {
                document.getElementById("actividad-vacia")?.remove();
                const item = document.createElement("li");
                item.className = "list-group-item";
                const hora = new Date().toLocaleTimeString("es-UY");
                item.innerHTML = `<div class="d-flex justify-content-between gap-2"><span class="js-texto"></span><small class="text-muted">${hora}</small></div><small class="text-muted js-detalle"></small>`;
                item.querySelector(".js-texto").textContent = texto;
                item.querySelector(".js-detalle").textContent = detalle ?? "";
                actividad.prepend(item);
                while (actividad.children.length > 50) actividad.lastElementChild.remove();
            }

            function sumar(selector, delta) {
                const el = document.querySelector(selector);
                if (el) el.textContent = Math.max(0, parseInt(el.textContent || "0", 10) + delta);
            }

            const conexion = new signalR.HubConnectionBuilder()
                // Solo WebSockets y sin negociación: la conexión no salta entre réplicas detrás del balanceador.
                .withUrl("@Plataforma.Backoffice.HubAvisosOperador.Ruta", { skipNegotiation: true, transport: signalR.HttpTransportType.WebSockets })
                .withAutomaticReconnect()
                .build();

            conexion.on("estadoEnvioCambiado", e => {
                const fila = document.querySelector(`tr[data-envio="${e.envioId}"]`);
                const tracking = fila?.dataset.tracking ?? e.envioId.substring(0, 8);
                if (fila) {
                    const badge = fila.querySelector("[data-estado]");
                    sumar(`[data-conteo="${badge.dataset.estado}"]`, -1);
                    badge.dataset.estado = e.estadoNuevo;
                    badge.className = "status-badge " + clase(e.estadoNuevo);
                    badge.textContent = nombre(e.estadoNuevo);
                    sumar(`[data-conteo="${e.estadoNuevo}"]`, 1);
                    fila.classList.add("table-warning");
                    setTimeout(() => fila.classList.remove("table-warning"), 2000);
                }
                registrar(`${tracking}: ${nombre(e.estadoAnterior)} → ${nombre(e.estadoNuevo)}`, "Cambio de estado");
            });

            conexion.on("avisoResultado", a => {
                const fila = document.querySelector(`tr[data-envio="${a.envioId}"]`);
                const tracking = fila?.dataset.tracking ?? a.envioId.substring(0, 8);
                if (a.estado === "Entregado") sumar("#avisos-entregados", 1);
                if (a.estado === "Fallido") sumar("#avisos-fallidos", 1);
                // Habla del aviso al sistema del comercio, no del paquete.
                const texto = a.estado === "Pendiente"
                    ? `Aviso al comercio de ${tracking}: falló el intento ${a.intentos}, se reintentará`
                    : a.estado === "Entregado"
                        ? `Aviso al comercio de ${tracking}: recibido por el comercio (intento ${a.intentos})`
                        : `Aviso al comercio de ${tracking}: falló tras ${a.intentos} intentos, quedó en fallidos`;
                registrar(texto, a.error ?? "");
            });

            conexion.onreconnecting(() => estadoConexion("Reconectando…", false));
            conexion.onreconnected(() => estadoConexion("En vivo", true));
            conexion.onclose(() => estadoConexion("Desconectado", false));

            conexion.start()
                .then(() => estadoConexion("En vivo", true))
                .catch(() => estadoConexion("Sin conexión en vivo", false));
        })();
    </script>
}
